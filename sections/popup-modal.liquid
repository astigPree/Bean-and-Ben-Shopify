{% liquid
  assign modal_enabled = section.settings.enabled
  assign modal_id = 'popup-modal-' | append: section.id
  assign modal_image = section.settings.image
  assign modal_heading = section.settings.heading
  assign modal_benefits = section.settings.benefits
  assign modal_benefit_list = modal_benefits | split: '|'
  assign modal_email_label = section.settings.email_label
  assign modal_email_placeholder = section.settings.email_placeholder
  assign modal_consent_label = section.settings.consent_label
  assign modal_button_label = section.settings.button_label
  assign modal_trigger_label = section.settings.trigger_label
  assign modal_privacy_text = section.settings.privacy_text
  assign modal_display_mode = section.settings.display_mode
  assign modal_delay = section.settings.delay
  assign modal_surface_color = section.settings.surface_color
  assign modal_text_color = section.settings.text_color
  assign modal_accent_color = section.settings.accent_color
  assign modal_button_text_color = section.settings.button_text_color
  assign modal_overlay_color = section.settings.overlay_color
  assign modal_image_background_color = section.settings.image_background_color
  assign modal_image_alt = section.settings.image_alt | default: modal_image.alt | default: modal_heading
  assign modal_form_id = 'NewsletterModalForm-' | append: modal_id

  assign show_image_on_mobile = section.settings.show_image_on_mobile
%}

{% if modal_enabled %}
  <section
    id="{{ modal_id }}"
    class="bb-modal"
    data-bb-modal
    data-display-mode="{{ modal_display_mode | escape }}"
    data-delay="{{ modal_delay }}"
    data-storage-key="bb-modal-{{ modal_id }}"
    aria-hidden="true"
    hidden
    style="
      --bb-modal-surface: {{ modal_surface_color }};
      --bb-modal-text: {{ modal_text_color }};
      --bb-modal-accent: {{ modal_accent_color }};
      --bb-modal-button-text: {{ modal_button_text_color }};
      --bb-modal-overlay: {{ modal_overlay_color }};
      --bb-modal-image-background: {{ modal_image_background_color }};
    "
  >
    <div class="bb-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="{{ modal_id }}-heading">
      <button class="bb-modal__close" type="button" data-bb-modal-close aria-label="Close newsletter signup">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path d="m5 5 14 14M19 5 5 19"></path>
        </svg>
      </button>

      {% if modal_image != blank %}
        <div class="bb-modal__image-panel{% if show_image_on_mobile %} bb-modal__image-panel--mobile{% endif %}">
          {{
            modal_image
            | image_url: width: 1100
            | image_tag:
              widths: '480, 720, 960, 1100',
              sizes: '(min-width: 750px) 50vw, 100vw',
              class: 'bb-modal__image',
              loading: 'lazy',
              alt: modal_image_alt
          }}
        </div>
      {% endif %}

      <div class="bb-modal__content">
        {% if modal_heading != blank %}
          <h2 id="{{ modal_id }}-heading" class="bb-modal__heading">{{ modal_heading | escape | newline_to_br }}</h2>
        {% endif %}

        {% if modal_benefit_list.size > 0 %}
          <ul class="bb-modal__benefits" role="list">
            {% for benefit in modal_benefit_list %}
              {% assign benefit_text = benefit | strip %}
              {% if benefit_text != blank %}
                <li>{{ benefit_text | escape }}</li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}

        {% form 'customer', id: modal_form_id, class: 'bb-modal__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">

          <label for="{{ modal_id }}-email">{{ modal_email_label | escape }}</label>
          <input
            id="{{ modal_id }}-email"
            class="bb-modal__email"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            placeholder="{{ modal_email_placeholder | escape }}"
            autocapitalize="off"
            autocomplete="email"
            autocorrect="off"
            required
          >

          {% if modal_consent_label != blank %}
            <label class="bb-modal__consent" for="{{ modal_id }}-consent">
              <input id="{{ modal_id }}-consent" type="checkbox" name="contact[accepts_marketing]" value="true">
              <span>{{ modal_consent_label | escape }}</span>
            </label>
          {% endif %}

          <button class="bb-modal__submit" type="submit">{{ modal_button_label | escape }}</button>

          {% if modal_privacy_text != blank %}
            <p class="bb-modal__privacy">{{ modal_privacy_text | escape }}</p>
          {% endif %}

          {% if form.posted_successfully? %}
            <p class="bb-modal__status" role="status">Thanks for subscribing.</p>
          {% endif %}

          {% if form.errors %}
            <div class="bb-modal__status bb-modal__status--error" role="alert">{{ form.errors | default_errors }}</div>
          {% endif %}
        {% endform %}
      </div>
    </div>
  </section>

  {% if modal_trigger_label != blank %}
    <button
      class="bb-modal__trigger"
      type="button"
      data-bb-modal-open="{{ modal_id }}"
      aria-controls="{{ modal_id }}"
      aria-expanded="false"
      hidden
      style="
        --bb-modal-surface: {{ modal_surface_color }};
        --bb-modal-accent: {{ modal_accent_color }};
        --bb-modal-button-text: {{ modal_button_text_color }};
      "
    >
      {{ modal_trigger_label | escape }}
    </button>
  {% endif %}
{% endif %}

{% stylesheet %}
  .bb-modal[hidden] {
    display: none;
  }

  .bb-modal__trigger {
    position: fixed;
    z-index: 999;
    inset-block-end: 0;
    inset-inline-start: 1.75rem;
    min-height: 3.9rem;
    padding: 0.85rem 2.3rem;
    border: 0;
    color: var(--bb-modal-button-text);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    background: var(--bb-modal-accent);
    box-shadow: 0 0.75rem 1.5rem rgb(0 0 0 / 18%);
    cursor: pointer;
    transition:
      opacity 180ms ease,
      transform 180ms ease,
      color 160ms ease,
      background-color 160ms ease;
  }

  .bb-modal__trigger[hidden] {
    display: none;
  }

  .bb-modal.is-open ~ .bb-modal__trigger {
    opacity: 0;
    pointer-events: none;
    transform: translateY(0.75rem);
  }

  .bb-modal__trigger:focus-visible {
    outline: 2px solid var(--bb-modal-accent);
    outline-offset: 3px;
  }

  .bb-modal {
    position: fixed;
    z-index: 1000;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1.25rem;
    overflow-y: auto;
    background: color-mix(in srgb, var(--bb-modal-overlay) 55%, transparent);
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .bb-modal.is-open {
    opacity: 1;
  }

  .bb-modal__dialog {
    position: relative;
    display: grid;
    width: min(100%, 70rem);
    max-height: min(47rem, calc(100dvh - 2.5rem));
    overflow: auto;
    color: var(--bb-modal-text);
    background: var(--bb-modal-surface);
    box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 28%);
    transform: translateY(1rem) scale(0.985);
    transition: transform 180ms ease;
  }

  .bb-modal.is-open .bb-modal__dialog {
    transform: translateY(0) scale(1);
  }

  .bb-modal__close {
    position: absolute;
    z-index: 1;
    inset-block-start: 0.85rem;
    inset-inline-end: 0.85rem;
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    place-items: center;
    border: 0;
    color: var(--bb-modal-text);
    background: transparent;
    cursor: pointer;
  }

  .bb-modal__close svg {
    width: 1.5rem;
    height: 1.5rem;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 2;
  }

  .bb-modal__image-panel {
    display: none;
    min-height: 100%;
    background: var(--bb-modal-image-background);
  }

  .bb-modal__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bb-modal__content {
    display: flex;
    min-height: 31rem;
    flex-direction: column;
    justify-content: center;
    padding: clamp(4.5rem, 8vw, 6.5rem) clamp(2rem, 6vw, 5rem) clamp(2rem, 5vw, 4.25rem);
  }

  .bb-modal__heading {
    max-width: 25rem;
    margin: 0;
    font: inherit;
    font-size: clamp(1.15rem, 1.8vw, 1.55rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.12;
  }

  .bb-modal__benefits {
    display: grid;
    gap: 1.55rem;
    margin: 2.25rem 0;
    padding: 0;
    list-style: none;
  }

  .bb-modal__benefits li {
    position: relative;
    padding-inline-start: 0.9rem;
    font-size: 1rem;
    line-height: 1.25;
  }

  .bb-modal__benefits li::before {
    position: absolute;
    inset-inline-start: 0;
    content: '•';
  }

  .bb-modal__form {
    display: grid;
    gap: 0.7rem;
  }

  .bb-modal__form > label:not(.bb-modal__consent) {
    color: var(--bb-modal-accent);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .bb-modal__email {
    width: 100%;
    min-height: 4.4rem;
    padding: 0.85rem 1.2rem;
    border: 1px solid var(--bb-modal-accent);
    border-radius: 0;
    color: var(--bb-modal-text);
    font: inherit;
    background: transparent;
  }

  .bb-modal__email:focus-visible,
  .bb-modal__close:focus-visible,
  .bb-modal__submit:focus-visible,
  .bb-modal__consent input:focus-visible {
    outline: 2px solid var(--bb-modal-accent);
    outline-offset: 3px;
  }

  .bb-modal__consent {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    margin-block: 0.15rem 0.8rem;
    color: var(--bb-modal-accent);
    font-size: 0.85rem;
    line-height: 1.25;
  }

  .bb-modal__consent input {
    width: 1.4rem;
    height: 1.4rem;
    flex: 0 0 auto;
    margin: 0;
    accent-color: var(--bb-modal-accent);
  }

  .bb-modal__submit {
    min-height: 4.35rem;
    border: 1px solid var(--bb-modal-accent);
    color: var(--bb-modal-button-text);
    font: inherit;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    background: var(--bb-modal-accent);
    cursor: pointer;
  }

  .bb-modal__privacy,
  .bb-modal__status {
    margin: 0.15rem 0 0;
    color: color-mix(in srgb, var(--bb-modal-text) 68%, transparent);
    font-size: 0.8rem;
    text-align: center;
  }

  .bb-modal__status--error {
    color: #b42318;
  }

  .bb-modal-scroll-locked {
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .bb-modal__dialog {
      grid-template-columns: minmax(0, 1fr) minmax(25rem, 1fr);
    }

    .bb-modal__image-panel {
      display: block;
    }
  }

  @media screen and (max-width: 749px) {
    .bb-modal__trigger {
      inset-block-end: 0;
      inset-inline-start: 1.15rem;
      min-height: 3.65rem;
      padding-inline: 1.8rem;
      font-size: 0.82rem;
    }

    .bb-modal__image-panel--mobile {
      display: block;
      max-height: 13rem;
    }

    .bb-modal__content {
      min-height: 0;
    }
  }

  @media (hover: hover) {
    .bb-modal__trigger:hover {
      color: var(--bb-modal-accent);
      background: var(--bb-modal-surface);
    }

    .bb-modal__close:hover {
      color: var(--bb-modal-accent);
    }

    .bb-modal__submit:hover {
      color: var(--bb-modal-accent);
      background: transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bb-modal,
    .bb-modal__dialog,
    .bb-modal__trigger {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const focusableSelector = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

    document.querySelectorAll('[data-bb-modal]').forEach((modal) => {
      const dialog = modal.querySelector('[role="dialog"]');
      const closeButton = modal.querySelector('[data-bb-modal-close]');
      const triggers = [...document.querySelectorAll(`[data-bb-modal-open="${modal.id}"]`)];
      const mode = modal.dataset.displayMode;
      const storageKey = modal.dataset.storageKey;
      let opener;

      const hasBeenDismissed = () => {
        if (mode === 'once_per_session') return sessionStorage.getItem(storageKey) === 'dismissed';
        if (mode === 'once_per_visitor') return localStorage.getItem(storageKey) === 'dismissed';
        return false;
      };

      const rememberDismissal = () => {
        if (mode === 'once_per_session') sessionStorage.setItem(storageKey, 'dismissed');
        if (mode === 'once_per_visitor') localStorage.setItem(storageKey, 'dismissed');
      };

      const open = (trigger) => {
        if (!modal.hidden) return;
        opener = trigger || document.activeElement;
        triggers.forEach((modalTrigger) => {
          modalTrigger.hidden = true;
          modalTrigger.setAttribute('aria-expanded', 'true');
        });
        modal.hidden = false;
        modal.setAttribute('aria-hidden', 'false');
        document.documentElement.classList.add('bb-modal-scroll-locked');
        window.requestAnimationFrame(() => modal.classList.add('is-open'));
        window.setTimeout(() => closeButton.focus(), 180);
      };

      const close = (shouldRemember = true) => {
        if (modal.hidden) return;
        if (shouldRemember) rememberDismissal();
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        window.setTimeout(() => {
          modal.hidden = true;
          if (!document.querySelector('[data-bb-modal]:not([hidden])')) {
            document.documentElement.classList.remove('bb-modal-scroll-locked');
          }
          triggers.forEach((modalTrigger) => {
            modalTrigger.hidden = false;
            modalTrigger.setAttribute('aria-expanded', 'false');
          });
          if (opener && typeof opener.focus === 'function') opener.focus();
        }, 180);
      };

      closeButton.addEventListener('click', () => close());

      modal.addEventListener('click', (event) => {
        if (event.target === modal) close();
      });

      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          event.preventDefault();
          close();
        }

        if (event.key === 'Tab') {
          const focusable = [...dialog.querySelectorAll(focusableSelector)];
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (!first || !last) return;
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        }
      });

      triggers.forEach((trigger) => {
        trigger.addEventListener('click', (event) => {
          event.preventDefault();
          open(trigger);
        });
      });

      if (mode !== 'manual') {
        if (hasBeenDismissed()) {
          triggers.forEach((modalTrigger) => {
            modalTrigger.hidden = false;
            modalTrigger.setAttribute('aria-expanded', 'false');
          });
        } else {
          const delay = Number.parseInt(modal.dataset.delay, 10) || 0;
          window.setTimeout(() => open(), delay);
        }
      }
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Popup modal",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Enable modal", "default": true },
    {
      "type": "select",
      "id": "display_mode",
      "label": "When to show",
      "options": [
        { "value": "always", "label": "On every page load" },
        { "value": "once_per_session", "label": "Once per browser session" },
        { "value": "once_per_visitor", "label": "Once per visitor" },
        { "value": "manual", "label": "Only from an external trigger" }
      ],
      "default": "always"
    },
    { "type": "range", "id": "delay", "label": "Show delay", "min": 0, "max": 9500, "step": 500, "unit": "ms", "default": 0 },
    { "type": "header", "content": "Artwork" },
    { "type": "image_picker", "id": "image", "label": "Promotional image", "info": "Shown beside the form on desktop." },
    { "type": "text", "id": "image_alt", "label": "Promotional image description" },
    { "type": "checkbox", "id": "show_image_on_mobile", "label": "Show promotional image on mobile", "default": false },
    { "type": "header", "content": "Content" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Be the first to hear about new coffees, offers, and events." },
    { "type": "textarea", "id": "benefits", "label": "Benefits", "default": "Early access to new menu launches|Exclusive offers and events|Stories from Bean & Ben", "info": "Separate each benefit with a vertical bar (|)." },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email address" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "Email address" },
    { "type": "text", "id": "consent_label", "label": "Consent label", "default": "Yes, I’d like updates from Bean & Ben" },
    { "type": "text", "id": "button_label", "label": "Submit button label", "default": "Join the list" },
    { "type": "text", "id": "trigger_label", "label": "Fixed popup button label", "default": "Join the list", "info": "Shown bottom-left after the visitor closes the modal. Leave empty to hide it." },
    { "type": "text", "id": "privacy_text", "label": "Privacy text", "default": "No spam. Unsubscribe anytime." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "surface_color", "label": "Modal background", "default": "#fffaf9" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#161616" },
    { "type": "color", "id": "accent_color", "label": "Accent and button", "default": "#6f197f" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" },
    { "type": "color", "id": "overlay_color", "label": "Page overlay", "default": "#000000" },
    { "type": "color", "id": "image_background_color", "label": "Image panel background", "default": "#f4e8f8" }
  ],
  "presets": [
    { "name": "Popup modal" }
  ]
}
{% endschema %}
