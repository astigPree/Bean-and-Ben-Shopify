{% comment %}
  CONTACT PAGE DATA SETUP
  Theme Editor values are available through `section.settings`. The generated
  form ID includes `section.id`, which keeps it unique if this section appears
  more than once on a page.
{% endcomment %}
{% liquid
  assign contact_form_id = 'ContactForm-' | append: section.id
  assign has_contact_details = false

  # Show the details area when at least one verified contact value is provided.
  if section.settings.contact_email != blank
    assign has_contact_details = true
  endif

  if section.settings.contact_phone != blank
    assign has_contact_details = true
  endif

  if section.settings.venue_address != blank
    assign has_contact_details = true
  endif

  if section.settings.opening_hours != blank
    assign has_contact_details = true
  endif

  if section.settings.facebook_url != blank
    assign has_contact_details = true
  endif

  # Remove visual punctuation so the phone number works safely in a tel: link.
  assign phone_href = section.settings.contact_phone
  assign phone_href = phone_href | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
%}

{% comment %}
  `aria-labelledby` connects this section to its visible page heading.
  `section.id` ensures the heading ID is unique in the rendered page.
{% endcomment %}
<section
  class="contact-page full-width"
  aria-labelledby="ContactPageHeading-{{ section.id }}"
>
  <div class="contact-page__inner">
    {% comment %}
      PAGE INTRODUCTION
      Most text comes from the Theme Editor. Optional `page.content` comes from
      the Shopify page record assigned to this contact template.
    {% endcomment %}
    <header class="contact-page__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="contact-page__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      <h1 id="ContactPageHeading-{{ section.id }}" class="contact-page__heading">
        {{ section.settings.heading | escape }}
      </h1>

      {% if section.settings.intro_text != blank %}
        <p class="contact-page__intro-text">{{ section.settings.intro_text | escape }}</p>
      {% endif %}

      {% if section.settings.show_page_content %}
        {% if page.content != blank %}
          <div class="contact-page__page-content rte">
            {{ page.content }}
          </div>
        {% endif %}
      {% endif %}
    </header>

    <div class="contact-page__layout">
      <div class="contact-page__form-panel">
        <div class="contact-page__panel-heading">
          <div>
            {% if section.settings.form_heading != blank %}
              <h2>{{ section.settings.form_heading | escape }}</h2>
            {% endif %}

            {% if section.settings.form_text != blank %}
              <p>{{ section.settings.form_text | escape }}</p>
            {% endif %}
          </div>

          <span class="contact-page__panel-number" aria-hidden="true">01</span>
        </div>

        {% comment %}
          Shopify's native contact form sends submissions through the store's
          configured contact email. No external form service or API key is used.
        {% endcomment %}
        {% form 'contact', id: contact_form_id, class: 'contact-page__form' %}
          {% comment %}
            After a valid submission Shopify sets `posted_successfully?` to true.
            The form is replaced by the merchant-configurable success message.
          {% endcomment %}
          {% if form.posted_successfully? %}
            <div class="contact-page__success" tabindex="-1" role="status">
              <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
                <circle cx="24" cy="24" r="20"></circle>
                <path d="m15 24 6 6 13-14"></path>
              </svg>
              <div>
                <h2>{{ section.settings.success_heading | escape }}</h2>
                <p>{{ section.settings.success_text | escape }}</p>
              </div>
            </div>
          {% else %}
            {% comment %}
              If Shopify rejects a submission, `form.errors` contains the
              validation messages. `default_errors` formats them as a list.
            {% endcomment %}
            {% if form.errors %}
              <div class="contact-page__errors" role="alert" tabindex="-1">
                <p>{{ 'contact.error_heading' | t }}</p>
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <p class="contact-page__required-note">{{ 'contact.required_note' | t }}</p>

            {% comment %}
              FORM FIELD NAMES
              Inputs named `contact[...]` are collected by Shopify and included
              in the email sent to the store. Email and body use Shopify's
              standard keys; custom keys such as Inquiry type are also included.
              The `required` attribute enables browser-side validation.
            {% endcomment %}
            <div class="contact-page__fields">
              <div class="contact-page__field contact-page__field--half">
                <label for="ContactName-{{ section.id }}">
                  {{ 'contact.name' | t }}
                  <span aria-hidden="true">*</span>
                </label>
                <input
                  id="ContactName-{{ section.id }}"
                  type="text"
                  name="contact[name]"
                  {% comment %}Keep the entered value after an unsuccessful submission.{% endcomment %}
                  value="{{ form.name | escape }}"
                  autocomplete="name"
                  required
                >
              </div>

              <div class="contact-page__field contact-page__field--half">
                <label for="ContactEmail-{{ section.id }}">
                  {{ 'contact.email' | t }}
                  <span aria-hidden="true">*</span>
                </label>
                <input
                  id="ContactEmail-{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email | escape }}"
                  autocapitalize="off"
                  autocomplete="email"
                  autocorrect="off"
                  required
                >
              </div>

              <div class="contact-page__field contact-page__field--half">
                <label for="ContactPhone-{{ section.id }}">{{ 'contact.phone' | t }}</label>
                <input
                  id="ContactPhone-{{ section.id }}"
                  type="tel"
                  name="contact[phone]"
                  value="{{ form.phone | escape }}"
                  autocomplete="tel"
                >
              </div>

              <div class="contact-page__field contact-page__field--half">
                <label for="ContactTopic-{{ section.id }}">
                  {{ 'contact.inquiry_type' | t }}
                  <span aria-hidden="true">*</span>
                </label>
                <select id="ContactTopic-{{ section.id }}" name="contact[Inquiry type]" required>
                  <option value="" selected disabled>{{ 'contact.choose_topic' | t }}</option>
                  <option value="General question">{{ 'contact.topic_general' | t }}</option>
                  <option value="Coworking">{{ 'contact.topic_coworking' | t }}</option>
                  <option value="Gaming">{{ 'contact.topic_gaming' | t }}</option>
                  <option value="Events or group visit">{{ 'contact.topic_events' | t }}</option>
                  <option value="Menu or allergen question">{{ 'contact.topic_menu' | t }}</option>
                  <option value="Other">{{ 'contact.topic_other' | t }}</option>
                </select>
              </div>

              <div class="contact-page__field">
                <label for="ContactSubject-{{ section.id }}">{{ 'contact.subject' | t }}</label>
                <input
                  id="ContactSubject-{{ section.id }}"
                  type="text"
                  name="contact[Subject]"
                >
              </div>

              <div class="contact-page__field">
                <label for="ContactMessage-{{ section.id }}">
                  {{ 'contact.message' | t }}
                  <span aria-hidden="true">*</span>
                </label>
                <textarea
                  id="ContactMessage-{{ section.id }}"
                  name="contact[body]"
                  rows="7"
                  required
                >{{ form.body | escape }}</textarea>
              </div>
            </div>

            {% comment %}
              Privacy text is intentionally optional until the business approves
              the exact wording in the Theme Editor.
            {% endcomment %}
            {% if section.settings.privacy_note != blank %}
              <p class="contact-page__privacy-note">{{ section.settings.privacy_note | escape }}</p>
            {% endif %}

            <button class="contact-page__submit" type="submit">
              <span>{{ section.settings.button_label | escape }}</span>
              <svg viewBox="0 0 32 20" fill="none" aria-hidden="true">
                <path d="M1 10h28M21 2l8 8-8 8"></path>
              </svg>
            </button>
          {% endif %}
        {% endform %}
      </div>

      {% comment %}
        CONTACT DETAILS PANEL
        This aside displays only verified merchant-provided information. It is
        separate from the form so visitors can also contact or visit directly.
      {% endcomment %}
      <aside class="contact-page__details" aria-labelledby="ContactDetailsHeading-{{ section.id }}">
        <div class="contact-page__panel-heading">
          <div>
            {% if section.settings.details_heading != blank %}
              <h2 id="ContactDetailsHeading-{{ section.id }}">
                {{ section.settings.details_heading | escape }}
              </h2>
            {% endif %}

            {% if section.settings.details_text != blank %}
              <p>{{ section.settings.details_text | escape }}</p>
            {% endif %}
          </div>

          <span class="contact-page__panel-number" aria-hidden="true">02</span>
        </div>

        {% if has_contact_details %}
          {% comment %}
            These details intentionally have no public defaults. Add only
            verified business information in the Theme Editor before launch.
          {% endcomment %}
          <div class="contact-page__detail-list">
            {% if section.settings.contact_email != blank %}
              <div class="contact-page__detail">
                <span class="contact-page__detail-label">{{ 'contact.direct_email' | t }}</span>
                <a href="mailto:{{ section.settings.contact_email | escape }}">
                  {{ section.settings.contact_email | escape }}
                </a>
              </div>
            {% endif %}

            {% if section.settings.contact_phone != blank %}
              <div class="contact-page__detail">
                <span class="contact-page__detail-label">{{ 'contact.phone' | t }}</span>
                <a href="tel:{{ phone_href | escape }}">{{ section.settings.contact_phone | escape }}</a>
              </div>
            {% endif %}

            {% if section.settings.venue_address != blank %}
              <div class="contact-page__detail">
                <span class="contact-page__detail-label">{{ 'contact.visit' | t }}</span>
                <p>{{ section.settings.venue_address | escape | newline_to_br }}</p>
              </div>
            {% endif %}

            {% if section.settings.opening_hours != blank %}
              <div class="contact-page__detail">
                <span class="contact-page__detail-label">{{ 'contact.hours' | t }}</span>
                <p>{{ section.settings.opening_hours | escape | newline_to_br }}</p>
              </div>
            {% endif %}

            {% if section.settings.facebook_url != blank %}
              <div class="contact-page__detail">
                <span class="contact-page__detail-label">{{ 'contact.social' | t }}</span>
                <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener">
                  {{ section.settings.facebook_label | escape }}
                </a>
              </div>
            {% endif %}
          </div>
        {% elsif request.design_mode %}
          {% comment %}
            `request.design_mode` is true only in the Theme Editor. This setup
            reminder helps the merchant but never appears on the live storefront.
          {% endcomment %}
          <p class="contact-page__editor-note">
            Add verified email, phone, address, hours, or Facebook details in this section's settings.
          </p>
        {% endif %}

        <div class="contact-page__response-note">
          <span class="contact-page__response-line" aria-hidden="true"></span>
          <p>{{ section.settings.response_note | escape }}</p>
        </div>
      </aside>
    </div>
  </div>
</section>

{% stylesheet %}
  /* Mobile-first contact page foundation. */
  .contact-page {
    width: 100%;
    color: var(--color-foreground, #f3f0e8);
    background:
      radial-gradient(circle at 85% 8%, rgb(211 163 90 / 8%), transparent 24rem),
      var(--color-background, #050505);
  }

  /*
   * CONTENT WIDTH
   * Centers the page and reuses the global mobile spacing and page-width values.
   */
  .contact-page__inner {
    display: flex;
    width: min(100%, var(--page-width, 90rem));
    flex-direction: column;
    gap: clamp(2.5rem, 10vw, 4rem);
    margin-inline: auto;
    padding:
      var(--mobile-section-spacing, 4.5rem)
      var(--page-margin, 1.25rem);
  }

  .contact-page__intro {
    display: flex;
    max-width: 62rem;
    flex-direction: column;
    align-items: flex-start;
  }

  .contact-page__eyebrow,
  .contact-page__required-note,
  .contact-page__detail-label {
    margin: 0;
    color: var(--color-highlight, #d3a35a);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .contact-page__heading {
    max-width: 11ch;
    margin: 1rem 0 0;
    font-family: var(--font-display--family, Impact, sans-serif);
    font-size: clamp(4rem, 17vw, 6.25rem);
    font-style: var(--font-display--style, normal);
    font-weight: var(--font-display--weight, 400);
    letter-spacing: 0.01em;
    line-height: 0.88;
    text-transform: uppercase;
  }

  .contact-page__intro-text,
  .contact-page__page-content {
    max-width: 46rem;
    margin: 1.5rem 0 0;
    font-size: clamp(1rem, 4.2vw, 1.2rem);
    line-height: 1.65;
  }

  .contact-page__page-content > :first-child {
    margin-block-start: 0;
  }

  .contact-page__page-content > :last-child {
    margin-block-end: 0;
  }

  /*
   * MOBILE LAYOUT
   * The form and details panels stack vertically first. Desktop rules later
   * place them side by side using Flexbox.
   */
  .contact-page__layout {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-page__form-panel,
  .contact-page__details {
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 5vw, 2rem);
    border: 1px solid color-mix(in srgb, var(--color-border, #c7cbd0) 48%, transparent);
    background: color-mix(in srgb, var(--color-background, #050505) 82%, var(--color-secondary, #151515));
  }

  .contact-page__panel-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block-end: 1.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-border, #c7cbd0) 35%, transparent);
  }

  .contact-page__panel-heading h2,
  .contact-page__success h2 {
    margin: 0;
    font-family: var(--font-display--family, Impact, sans-serif);
    font-size: clamp(1.75rem, 8vw, 2.6rem);
    font-style: var(--font-display--style, normal);
    font-weight: var(--font-display--weight, 400);
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
  }

  .contact-page__panel-heading p {
    max-width: 42rem;
    margin: 0.75rem 0 0;
    color: color-mix(in srgb, var(--color-foreground, #f3f0e8) 72%, transparent);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .contact-page__panel-number {
    flex: 0 0 auto;
    color: var(--color-highlight, #d3a35a);
    font-family: var(--font-display--family, Impact, sans-serif);
    font-size: 1.5rem;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  /* Shopify adds submission state inside this form container after a POST. */
  .contact-page__form {
    display: flex;
    flex-direction: column;
    margin-block-start: 1.5rem;
  }

  .contact-page__required-note {
    color: color-mix(in srgb, var(--color-foreground, #f3f0e8) 60%, transparent);
  }

  /*
   * FORM FIELDS
   * Flexbox keeps every field full-width on phones. Fields marked `--half`
   * become two columns at the 700px breakpoint.
   */
  .contact-page__fields {
    display: flex;
    flex-wrap: wrap;
    gap: 1.15rem;
    margin-block-start: 1rem;
  }

  .contact-page__field {
    display: flex;
    width: 100%;
    flex: 1 1 100%;
    flex-direction: column;
    gap: 0.55rem;
  }

  .contact-page__field label {
    color: var(--color-foreground, #f3f0e8);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .contact-page__field label span {
    color: var(--color-highlight, #d3a35a);
  }

  .contact-page__field input,
  .contact-page__field select,
  .contact-page__field textarea {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.8rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--color-border, #c7cbd0) 50%, transparent);
    border-radius: var(--style-border-radius-inputs, 4px);
    outline: 0;
    color: var(--color-foreground, #f3f0e8);
    background: var(--color-background, #050505);
    font: inherit;
    font-size: 1rem;
    line-height: 1.4;
  }

  .contact-page__field textarea {
    min-height: 10rem;
    resize: vertical;
  }

  .contact-page__field select {
    cursor: pointer;
  }

  /* A strong keyboard focus indicator keeps all controls accessible. */
  .contact-page__field input:focus-visible,
  .contact-page__field select:focus-visible,
  .contact-page__field textarea:focus-visible {
    border-color: var(--color-foreground, #f3f0e8);
    box-shadow: 0 0 0 1px var(--color-foreground, #f3f0e8);
  }

  .contact-page__privacy-note {
    max-width: 48rem;
    margin: 1rem 0 0;
    color: color-mix(in srgb, var(--color-foreground, #f3f0e8) 62%, transparent);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .contact-page__submit {
    display: inline-flex;
    width: 100%;
    min-height: 3.5rem;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-block-start: 1.25rem;
    padding: 0.85rem 1.25rem;
    border: 1px solid var(--color-action, #f3f0e8);
    border-radius: var(--style-border-radius-buttons, 4px);
    color: var(--color-action-text, #050505);
    background: var(--color-action, #f3f0e8);
    cursor: pointer;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1;
    text-transform: uppercase;
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  .contact-page__submit svg {
    width: 1.75rem;
    flex: 0 0 auto;
    stroke: currentColor;
    stroke-linecap: square;
    stroke-linejoin: miter;
    stroke-width: 1.5;
  }

  /* Shopify validation errors and the successful-submit message share a panel style. */
  .contact-page__errors,
  .contact-page__success {
    display: flex;
    padding: 1rem;
    border: 1px solid var(--color-highlight, #d3a35a);
    background: color-mix(in srgb, var(--color-highlight, #d3a35a) 8%, transparent);
  }

  .contact-page__errors {
    flex-direction: column;
    gap: 0.5rem;
    margin-block-end: 1rem;
  }

  .contact-page__errors p,
  .contact-page__errors ul {
    margin: 0;
  }

  .contact-page__errors ul {
    padding-inline-start: 1.25rem;
  }

  .contact-page__success {
    align-items: flex-start;
    gap: 1rem;
  }

  .contact-page__success svg {
    width: 2.75rem;
    flex: 0 0 2.75rem;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .contact-page__success p {
    margin: 0.65rem 0 0;
    line-height: 1.55;
  }

  /* Verified email, phone, address, hours, and social links use this list. */
  .contact-page__details {
    gap: 1.75rem;
  }

  .contact-page__detail-list {
    display: flex;
    flex-direction: column;
  }

  .contact-page__detail {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding-block: 1.15rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-border, #c7cbd0) 24%, transparent);
  }

  .contact-page__detail:first-child {
    padding-block-start: 0;
  }

  .contact-page__detail a,
  .contact-page__detail p {
    margin: 0;
    color: var(--color-foreground, #f3f0e8);
    font-size: 1rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .contact-page__detail a {
    text-decoration-color: color-mix(in srgb, var(--color-highlight, #d3a35a) 65%, transparent);
    text-underline-offset: 0.25em;
  }

  .contact-page__editor-note {
    margin: 0;
    padding: 1rem;
    border: 1px dashed color-mix(in srgb, var(--color-highlight, #d3a35a) 65%, transparent);
    color: var(--color-highlight, #d3a35a);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .contact-page__response-note {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-block-start: auto;
  }

  .contact-page__response-line {
    width: 100%;
    height: 1px;
    background: color-mix(in srgb, var(--color-highlight, #d3a35a) 72%, transparent);
  }

  .contact-page__response-note p {
    margin: 0;
    color: color-mix(in srgb, var(--color-foreground, #f3f0e8) 72%, transparent);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  @media (hover: hover) {
    .contact-page__submit:hover {
      color: var(--color-action, #f3f0e8);
      background: transparent;
    }

    .contact-page__detail a:hover {
      color: var(--color-highlight, #d3a35a);
    }
  }

  /* Wider screens place half-width fields in two columns. */
  @media screen and (min-width: 700px) {
    .contact-page__field--half {
      width: calc(50% - 0.575rem);
      flex-basis: calc(50% - 0.575rem);
    }

    .contact-page__submit {
      width: auto;
      align-self: flex-start;
      padding-inline: 2rem;
    }
  }

  /* Desktop uses an asymmetric form/details split while remaining Flexbox-only. */
  @media screen and (min-width: 990px) {
    .contact-page__inner {
      gap: clamp(3.5rem, 5vw, 5.5rem);
      padding:
        var(--desktop-section-spacing, 8.75rem)
        var(--desktop-page-margin, 4rem);
    }

    .contact-page__heading {
      font-size: clamp(5.5rem, 8vw, 8.5rem);
    }

    .contact-page__intro-text {
      font-size: 1.15rem;
    }

    .contact-page__layout {
      flex-direction: row;
      align-items: stretch;
    }

    .contact-page__form-panel {
      width: calc(64% - 0.5rem);
      flex: 1 1 calc(64% - 0.5rem);
      padding: clamp(2rem, 3vw, 3rem);
    }

    .contact-page__details {
      width: calc(36% - 0.5rem);
      flex: 0 0 calc(36% - 0.5rem);
      padding: clamp(2rem, 3vw, 3rem);
    }
  }

  /* Respect visitors who request reduced interface motion. */
  @media (prefers-reduced-motion: reduce) {
    .contact-page__submit {
      transition: none;
    }
  }
{% endstylesheet %}

{% comment %}
  THEME EDITOR SETTINGS
  This JSON schema creates the contact section's controls and limits the section
  to page templates. It must remain valid JSON, so comments cannot go inside it.
{% endcomment %}
{% schema %}
{
  "name": "Contact page",
  "settings": [
    {
      "type": "header",
      "content": "Introduction"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "MEET US AT THE TOP"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CONTACT BEAN & BEN"
    },
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Introduction",
      "default": "Questions about coffee, coworking, gaming, events, or your next visit? Send us a message."
    },
    {
      "type": "checkbox",
      "id": "show_page_content",
      "label": "Show Shopify page content",
      "default": false
    },
    {
      "type": "header",
      "content": "Contact form"
    },
    {
      "type": "text",
