{% comment %}
  COLLECTION DATA SETUP
  Shopify automatically provides the `collection` object on collection pages.
  It contains the current collection's title, description, products, sorting
  options, and URLs. Section settings come from the Theme Editor schema below.
{% endcomment %}
{% liquid
  assign catalog_heading = section.settings.heading
  assign catalog_context_title = collection.current_type | default: collection.title
  assign current_sort = collection.sort_by | default: collection.default_sort_by
  assign products_per_page = section.settings.products_per_page | default: 24
  assign all_products_is_current = false
  assign category_dropdown_label = section.settings.all_products_label | default: 'All products'

  if collection.current_type != blank
    assign category_dropdown_label = collection.current_type
  endif

  if collection.current_type == blank
    if collection.handle == 'all'
      assign all_products_is_current = true
    endif
  endif

  # Use the live Shopify collection title when no heading override is entered.
  if catalog_heading == blank
    assign catalog_heading = collection.title
  endif
%}

{% comment %}
  `section.id` makes the heading ID unique if this section is used more than
  once. `aria-labelledby` connects that heading to the complete catalog region.
{% endcomment %}
<section
  class="catalog-page full-width"
  aria-labelledby="CatalogHeading-{{ section.id }}"
>
  <div class="catalog-page__inner">
    {% comment %}
      CATALOG INTRODUCTION
      The eyebrow and heading override are editable in the Theme Editor.
      The description and product count come from the current collection.
    {% endcomment %}
    <header class="catalog-page__hero" data-catalog-reveal="hero">
      <div class="catalog-page__hero-copy">
        {% if section.settings.eyebrow != blank %}
          <p class="catalog-page__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        <h1 id="CatalogHeading-{{ section.id }}" class="catalog-page__heading">
          {{ catalog_heading | escape }}
        </h1>
      </div>

      <div class="catalog-page__hero-support">
        {% comment %}
          Collection descriptions are managed in Shopify Admin and may contain
          rich text, so the container uses the shared `rte` class.
        {% endcomment %}
        {% if section.settings.show_collection_description %}
          {% if collection.description != blank %}
            <div class="catalog-page__description rte">
              {{ collection.description }}
            </div>
          {% endif %}
        {% endif %}

        <p class="catalog-page__count">
          {{ 'catalog.product_count' | t: count: collection.products_count }}
        </p>
      </div>
    </header>

    {% comment %}
      Store-wide product type links remain available after a type is selected.
      New types assigned in Shopify Admin appear here automatically.
    {% endcomment %}
    <nav class="catalog-page__categories" aria-label="{{ 'catalog.categories' | t }}" data-catalog-reveal="categories">
      <details class="catalog-page__category-dropdown" data-category-dropdown>
        <summary class="catalog-page__category-trigger">
          <span class="catalog-page__category-prompt">{{ 'catalog.categories' | t }}:</span>
          <span class="catalog-page__category-label">{{ category_dropdown_label | escape }}</span>
          <svg
            class="catalog-page__category-chevron"
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </summary>

        <div class="catalog-page__category-menu">
          <ul class="catalog-page__category-list" role="list">
            {% if section.settings.show_all_products_link %}
              <li>
                <a
                  class="catalog-page__category{% if all_products_is_current %} is-current{% endif %}"
                  href="{{ routes.all_products_collection_url }}"
                  {% if all_products_is_current %}
                    aria-current="page"
                  {% endif %}
                >
                  <span>{{ section.settings.all_products_label | escape }}</span>
                  {% if all_products_is_current %}
                    <span class="catalog-page__category-current">{{ 'catalog.current_category' | t }}</span>
                  {% endif %}
                </a>
              </li>
            {% endif %}

            {% for product_type in shop.types %}
              {% if product_type == blank %}
                {% continue %}
              {% endif %}

              <li>
                <a
                  class="catalog-page__category{% if collection.current_type == product_type %} is-current{% endif %}"
                  href="{{ product_type | url_for_type }}"
                  {% if collection.current_type == product_type %}
                    aria-current="page"
                  {% endif %}
                >
                  <span>{{ product_type | escape }}</span>
                  {% if collection.current_type == product_type %}
                    <span class="catalog-page__category-current">{{ 'catalog.current_category' | t }}</span>
                  {% endif %}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      </details>
    </nav>

    {% comment %}
      The toolbar confirms which collection is open and provides Shopify's
      built-in sorting choices when more than one choice is available.
    {% endcomment %}
    <div class="catalog-page__toolbar" data-catalog-reveal="toolbar">
      <p>{{ 'catalog.showing_collection' | t: title: catalog_context_title }}</p>

      {% if collection.sort_options.size > 1 %}
        {% comment %}
          Sorting uses a normal GET form and submit button, so the catalog
          remains fully usable without JavaScript.
        {% endcomment %}
        <form class="catalog-page__sort" action="{{ collection.url }}" method="get">
          {% if collection.current_type != blank %}
            <input type="hidden" name="q" value="{{ collection.current_type | escape }}">
          {% endif %}

          <label for="CatalogSort-{{ section.id }}">{{ 'catalog.sort_by' | t }}</label>
          <select id="CatalogSort-{{ section.id }}" name="sort_by">
            {% for option in collection.sort_options %}
              <option
                value="{{ option.value | escape }}"
                {% if option.value == current_sort %}
                  selected
                {% endif %}
              >
                {{ option.name | escape }}
              </option>
            {% endfor %}
          </select>
          <button type="submit">{{ 'catalog.apply' | t }}</button>
        </form>
      {% endif %}
    </div>

    {% comment %}
      PAGINATED PRODUCT LIST
      Shopify limits large Liquid loops, so `paginate` divides the collection
      into the number of products selected in the Theme Editor.
    {% endcomment %}
    {% paginate collection.products by products_per_page %}
      {% if collection.products_count > 0 %}
        <ul class="catalog-page__products" role="list">
          {% for product in collection.products %}
            {% comment %}
              Each product is delegated to the reusable menu-product-card
              snippet. These arguments decide which optional details it shows.
            {% endcomment %}
            {% render 'menu-product-card',
              product: product,
              show_description: section.settings.show_description,
              description_words: section.settings.description_words,
              show_badge: section.settings.show_badges,
              show_variants: section.settings.show_variants,
              variant_limit: section.settings.variant_limit
            %}
          {% endfor %}
        </ul>
      {% else %}
        {% comment %}
          Keep empty collections visually complete. The extra instruction is
          visible only inside the Theme Editor, never to storefront visitors.
        {% endcomment %}
        <div class="catalog-page__empty" data-catalog-reveal="empty">
          <svg viewBox="0 0 96 96" fill="none" aria-hidden="true">
            <path d="M23 33h46l-4 45H28l-5-45Z"></path>
            <path d="M20 24h52M30 17h32M37 50h22M40 61h16"></path>
          </svg>
          <h2>{{ section.settings.empty_heading | escape }}</h2>
          <p>{{ section.settings.empty_text | escape }}</p>

          {% if request.design_mode %}
            <small>Add products to this Shopify collection to populate the catalog.</small>
          {% endif %}
        </div>
      {% endif %}

      {% comment %}
        Pagination is rendered only when the collection needs multiple pages.
        Shopify supplies previous, next, current, and numbered page URLs.
      {% endcomment %}
      {% if paginate.pages > 1 %}
        <nav
          class="catalog-page__pagination"
          aria-label="{{ 'catalog.pagination' | t }}"
          data-catalog-reveal="pagination"
        >
          <p class="catalog-page__pagination-status">
            {{ 'catalog.pagination_status' | t: current: paginate.current_page, total: paginate.pages }}
          </p>

          <div class="catalog-page__pagination-controls">
            {% if paginate.previous %}
              <a class="catalog-page__pagination-arrow" href="{{ paginate.previous.url }}">
                <span aria-hidden="true">&larr;</span>
                {{ 'catalog.previous' | t }}
              </a>
            {% else %}
              <span class="catalog-page__pagination-arrow is-disabled" aria-disabled="true">
                <span aria-hidden="true">&larr;</span>
                {{ 'catalog.previous' | t }}
              </span>
            {% endif %}

            <div class="catalog-page__pagination-pages">
              {% for part in paginate.parts %}
                {% if part.is_link %}
                  <a href="{{ part.url }}" aria-label="{{ 'catalog.page' | t: number: part.title }}">
                    {{ part.title }}
                  </a>
                {% else %}
                  {% if part.title == paginate.current_page %}
                    <span class="is-current" aria-current="page">{{ part.title }}</span>
                  {% else %}
                    <span>{{ part.title }}</span>
                  {% endif %}
                {% endif %}
              {% endfor %}
            </div>

            {% if paginate.next %}
              <a class="catalog-page__pagination-arrow" href="{{ paginate.next.url }}">
                {{ 'catalog.next' | t }}
                <span aria-hidden="true">&rarr;</span>
              </a>
            {% else %}
              <span class="catalog-page__pagination-arrow is-disabled" aria-disabled="true">
                {{ 'catalog.next' | t }}
                <span aria-hidden="true">&rarr;</span>
              </span>
            {% endif %}
          </div>
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% stylesheet %}
  /* Mobile-first full catalog foundation. */
  .catalog-page {
    width: 100%;
    color: var(--color-foreground, #f3f0e8);
    background:
      radial-gradient(circle at 82% 5%, rgb(211 163 90 / 7%), transparent 24rem),
      var(--color-background, #050505);
  }

  /*
   * CONTENT WIDTH
   * Centers the catalog and reuses the global page-width and spacing settings.
   */
  .catalog-page__inner {
    display: flex;
    width: min(100%, var(--page-width, 90rem));
    flex-direction: column;
    gap: 2rem;
    margin-inline: auto;
    padding:
      var(--mobile-section-spacing, 4.5rem)
      var(--page-margin, 1.25rem);
  }

  .catalog-page__hero,
  .catalog-page__hero-copy,
  .catalog-page__hero-support {
    display: flex;
    flex-direction: column;
  }

  .catalog-page__hero {
    gap: 1.5rem;
    padding-block-end: 2rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-border, #c7cbd0) 38%, transparent);
  }

  .catalog-page__eyebrow {
    margin: 0;
    color: var(--color-highlight, #d3a35a);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .catalog-page__heading {
    max-width: 12ch;
    margin: 0.9rem 0 0;
    font-family: var(--font-display--family, Impact, sans-serif);
    font-size: clamp(4rem, 18vw, 6.5rem);
    font-style: var(--font-display--style, normal);
    font-weight: var(--font-display--weight, 400);
    letter-spacing: 0.01em;
    line-height: 0.88;
    text-transform: uppercase;
  }

  .catalog-page__hero-support {
    gap: 1rem;
  }

  .catalog-page__description {
    max-width: 45rem;
    color: color-mix(in srgb, var(--color-foreground, #f3f0e8) 78%, transparent);
    font-size: 1rem;
    line-height: 1.65;
  }

  .catalog-page__description > :first-child {
    margin-block-start: 0;
  }

  .catalog-page__description > :last-child {
    margin-block-end: 0;
  }

  .catalog-page__count {
    margin: 0;
    color: color-mix(in srgb, var(--color-foreground, #f3f0e8) 58%, transparent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  /* Product types use a compact disclosure instead of a long category rail. */
  .catalog-page__categories {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 28rem;
  }

  .catalog-page__category-dropdown {
    position: relative;
    width: 100%;
  }

  .catalog-page__category-trigger {
    display: flex;
    width: 100%;
    min-height: 3.25rem;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border: 1px solid color-mix(in srgb, var(--color-border, #c7cbd0) 52%, transparent);
    border-radius: 3px;
    color: var(--color-foreground, #f3f0e8);
    background: var(--color-surface, #151515);
    cursor: pointer;
    list-style: none;
    transition:
      color 160ms ease,
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .catalog-page__category-trigger::-webkit-details-marker {
    display: none;
  }

  .catalog-page__category-prompt {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .catalog-page__category-label {
    min-width: 0;
    flex: 1;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.25;
    overflow-wrap: anywhere;
    text-transform: uppercase;
  }

  .catalog-page__category-chevron {
    width: 1.125rem;
    height: 1.125rem;
    flex: 0 0 auto;
    color: var(--color-highlight, #d3a35a);
    transition: transform 180ms ease;
  }

  .catalog-page__category-dropdown[open] .catalog-page__category-chevron {
    transform: rotate(180deg);
  }

  .catalog-page__category-menu {
    position: absolute;
    z-index: 2;
    top: calc(100% + 0.4rem);
    inset-inline: 0;
    width: 100%;
    max-width: 28rem;
    max-height: min(22rem, 60vh);
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid color-mix(in srgb, var(--color-border, #c7cbd0) 48%, transparent);
    border-radius: 3px;
    background: var(--color-surface, #151515);
    box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 45%);
    scrollbar-color: var(--color-highlight, #d3a35a) color-mix(in srgb, var(--color-border, #c7cbd0) 12%, transparent);
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }

  .catalog-page__category-menu::-webkit-scrollbar {
    width: 0.45rem;
  }

  .catalog-page__category-menu::-webkit-scrollbar-track {
    background: color-mix(in srgb, var(--color-border, #c7cbd0) 12%, transparent);
  }

  .catalog-page__category-menu::-webkit-scrollbar-thumb {
    border-radius: 2px;
    background: var(--color-highlight, #d3a35a);
  }

  .catalog-page__category-list {
    display: flex;
    width: 100%;
    max-width: 28rem;
    flex-direction: column;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
  }

  .catalog-page__category-list li {
    margin: 0;
    padding: 0;
  }

  .catalog-page__category {
    display: flex;
    width: 100%;
    min-height: 2.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0.75rem;
    border-inline-start: 2px solid transparent;
    color: var(--color-foreground, #f3f0e8);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.25;
    overflow-wrap: anywhere;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      color 160ms ease,
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .catalog-page__category.is-current {
    border-inline-start-color: var(--color-highlight, #d3a35a);
    color: var(--color-action-text, #050505);
    background: var(--color-action, #f3f0e8);
  }

  .catalog-page__category-current {
    flex: 0 0 auto;
    color: color-mix(in srgb, currentColor 68%, transparent);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
  }

  .catalog-page__category-trigger:focus-visible,
  .catalog-page__category:focus-visible {
    outline: 2px solid var(--color-highlight, #d3a35a);
    outline-offset: 2px;
  }

  /*
   * SORTING TOOLBAR
   * The controls stack on small phones. A later breakpoint places them in one
   * row when enough horizontal space is available.
   */
  .catalog-page__toolbar {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-border, #c7cbd0) 28%, transparent);
    background: var(--color-secondary, #151515);
  }

  .catalog-page__toolbar > p {
    margin: 0;
    color: color-mix(in srgb, var(--color-foreground, #f3f0e8) 72%, transparent);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .catalog-page__sort {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  .catalog-page__sort label {
    width: 100%;
    color: var(--color-foreground, #f3f0e8);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .catalog-page__sort select,
  .catalog-page__sort button {
    min-height: 2.75rem;
    border-radius: var(--style-border-radius-inputs, 4px);
    font: inherit;
    font-size: 0.8rem;
  }

  .catalog-page__sort select {
    min-width: 0;
    flex: 1 1 12rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid color-mix(in srgb, var(--color-border, #c7cbd0) 50%, transparent);
    color: var(--color-foreground, #f3f0e8);
    background: var(--color-background, #050505);
  }

  .catalog-page__sort button {
    flex: 0 0 auto;
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-action, #f3f0e8);
    color: var(--color-action-text, #050505);
    background: var(--color-action, #f3f0e8);
    cursor: pointer;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /*
   * PRODUCT GRID
   * Flexbox starts with one card per row. Tablet and desktop breakpoints below
   * change the cards to two and then three columns.
   */
  .catalog-page__products {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu-product-card {
    display: flex;
    width: 100%;
    min-width: 0;
    flex: 1 1 100%;
  }

  /*
   * PRODUCT CARD
   * These selectors style HTML rendered by snippets/menu-product-card.liquid.
   * Keeping the reusable card markup in a snippet avoids duplicating it.
   */
  .menu-product-card__article {
    display: flex;
    width: 100%;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-highlight, #d3a35a) 32%, transparent);
    border-radius: min(var(--style-border-radius-cards, 6px), 8px);
    background: color-mix(in srgb, var(--color-secondary, #151515) 94%, black);
    box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 20%);
    transition:
      border-color 220ms ease,
      transform 220ms ease;
  }

  .menu-product-card__media {
    position: relative;
    display: flex;
    overflow: hidden;
    border-bottom: 1px solid color-mix(in srgb, var(--color-highlight, #d3a35a) 20%, transparent);
    background: var(--color-background, #050505);
    aspect-ratio: 1 / 1;
  }

  .menu-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    transition:
      opacity 430ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 430ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .menu-product-card__image--placeholder {
    padding: 15%;
    color: color-mix(in srgb, var(--color-highlight, #d3a35a) 45%, transparent);
    fill: currentColor;
  }

  .menu-product-card__badge {
    display: inline-flex;
    width: fit-content;
    min-height: 1.75rem;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--color-highlight, #d3a35a) 40%, transparent);
    border-radius: 999px;
    color: var(--color-highlight, #d3a35a);
    background: color-mix(in srgb, var(--color-background, #050505) 72%, transparent);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1;
    text-transform: uppercase;
  }

  .menu-product-card__badge::before {
    width: 0.3rem;
    height: 0.3rem;
    flex: 0 0 0.3rem;
    border-radius: 50%;
    background: currentColor;
    content: '';
  }

  .menu-product-card__content {
    display: flex;
    height: fit-content;
    flex-direction: column;
    align-items: flex-start;
    padding: 0.9rem 1rem 1rem;
  }

  .menu-product-card__title {
    width: 100%;
    margin: 0.8rem 0 0;
    font-family: var(--font-display--family, Impact, sans-serif);
    font-size: 1.55rem;
    font-style: var(--font-display--style, normal);
    font-weight: var(--font-display--weight, 400);
    letter-spacing: 0;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .menu-product-card__content > .menu-product-card__title:first-child {
    margin-block-start: 0;
  }

  .menu-product-card__title::after {
    display: block;
    width: 2rem;
    margin-block-start: 0.65rem;
    border-top: 2px dotted var(--color-highlight, #d3a35a);
    content: '';
  }

  .menu-product-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .menu-product-card__description {
    display: -webkit-box;
    overflow: hidden;
    margin: 0.75rem 0 0;
    color: color-mix(in srgb, var(--color-foreground, #f3f0e8) 72%, transparent);
    font-size: 0.68rem;
    line-height: 1.4;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .menu-product-card__dietary {
    margin: 0.75rem 0 0;
    color: var(--color-highlight, #d3a35a);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .menu-product-card__variants {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-block-start: 1rem;
  }

  .menu-product-card__variant {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.55rem;
    border: 1px solid color-mix(in srgb, var(--color-border, #c7cbd0) 28%, transparent);
    color: color-mix(in srgb, var(--color-foreground, #f3f0e8) 82%, transparent);
    font-size: 0.68rem;
    line-height: 1.3;
  }

  .menu-product-card__variant strong {
    color: var(--color-highlight, #d3a35a);
    font-weight: 700;
  }

  .menu-product-card__variant.is-unavailable {
    opacity: 0.48;
    text-decoration: line-through;
  }

  .menu-product-card__variant-more {
    width: 100%;
    margin: 0.15rem 0 0;
    color: color-mix(in srgb, var(--color-foreground, #f3f0e8) 55%, transparent);
    font-size: 0.68rem;
    line-height: 1.35;
  }

  .menu-product-card__visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .menu-product-card__footer {
    display: flex;
    width: 100%;
    min-width: 0;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.85rem;
    margin-block-start: auto;
    padding-block-start: 1.75rem;
  }

  .menu-product-card__price {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.2rem;
    margin: 0;
    color: var(--color-highlight, #d3a35a);
    font-family: var(--font-display--family, Impact, sans-serif);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1;
  }

  .menu-product-card__price span {
    white-space: nowrap;
  }

  .menu-product-card__price small {
    color: color-mix(in srgb, var(--color-foreground, #f3f0e8) 58%, transparent);
    font-size: 0.62rem;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .menu-product-card__link {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    justify-content: center;
    margin-inline-start: auto;
    padding: 0.6rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--color-highlight, #d3a35a) 75%, transparent);
    border-radius: 3px;
    color: color-mix(in srgb, var(--color-highlight, #d3a35a) 88%, var(--color-foreground, #f3f0e8));
    background: transparent;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      color 180ms ease,
      background-color 180ms ease;
  }

  .menu-product-card.is-sold-out .menu-product-card__image {
    filter: grayscale(0.7);
  }

  /* Empty-state styles prevent collections without products from looking broken. */
  .catalog-page__empty {
    display: flex;
    min-height: 26rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 2rem;
    border: 1px solid color-mix(in srgb, var(--color-border, #c7cbd0) 36%, transparent);
    text-align: center;
    background: var(--color-secondary, #151515);
  }

  .catalog-page__empty svg {
    width: 5rem;
    color: var(--color-highlight, #d3a35a);
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.4;
  }

  .catalog-page__empty h2 {
    margin: 0;
    font-family: var(--font-display--family, Impact, sans-serif);
    font-size: 2.5rem;
    font-style: var(--font-display--style, normal);
    font-weight: var(--font-display--weight, 400);
    letter-spacing: 0.04em;
    line-height: 1;
    text-transform: uppercase;
  }

  .catalog-page__empty p,
  .catalog-page__empty small {
    max-width: 32rem;
    margin: 0;
    line-height: 1.55;
  }

  .catalog-page__empty small {
    color: var(--color-highlight, #d3a35a);
  }

  /* Pagination links are sized as comfortable touch targets on mobile devices. */
  .catalog-page__pagination {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    margin-block-start: 1rem;
    padding-block-start: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--color-border, #c7cbd0) 28%, transparent);
  }

  .catalog-page__pagination-status {
    margin: 0;
    color: color-mix(in srgb, var(--color-foreground, #f3f0e8) 62%, transparent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .catalog-page__pagination-controls {
    display: grid;
    width: 100%;
    max-width: 32rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: 0.75rem;
  }

  .catalog-page__pagination-pages {
    display: grid;
    width: 100%;
    grid-column: 1 / -1;
    grid-row: 2;
    grid-template-columns: repeat(auto-fit, minmax(2.75rem, 1fr));
    gap: 0.35rem;
  }

  .catalog-page__pagination-pages a,
  .catalog-page__pagination-pages > span {
    display: inline-flex;
    width: 100%;
    min-width: 0;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    color: var(--color-foreground, #f3f0e8);
    font-size: 0.78rem;
    text-decoration: none;
  }

  .catalog-page__pagination-pages a,
  .catalog-page__pagination-pages span {
    border: 1px solid color-mix(in srgb, var(--color-border, #c7cbd0) 32%, transparent);
  }

  .catalog-page__pagination .is-current {
    color: var(--color-action-text, #050505);
    background: var(--color-action, #f3f0e8);
  }

  .catalog-page__pagination-arrow {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding-inline: 0.65rem;
    color: var(--color-foreground, #f3f0e8);
    font-size: 0.72rem;
    text-decoration: none;
    text-transform: uppercase;
  }

  .catalog-page__pagination-controls > .catalog-page__pagination-arrow:first-child {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
  }

  .catalog-page__pagination-controls > .catalog-page__pagination-arrow:last-child {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
  }

  .catalog-page__pagination-arrow.is-disabled {
    cursor: not-allowed;
    opacity: 0.35;
  }

  @media (hover: hover) {
    .catalog-page__category-trigger:hover,
    .menu-product-card__link:hover {
      border-color: var(--color-highlight, #d3a35a);
    }

    .catalog-page__category:hover:not(.is-current) {
      color: var(--color-action-text, #050505);
      background: var(--color-action, #f3f0e8);
    }

    .menu-product-card__article:hover {
      border-color: color-mix(in srgb, var(--color-highlight, #d3a35a) 62%, transparent);
      transform: translateY(-2px);
    }

    .menu-product-card__link:hover {
      color: var(--color-background, #050505);
      background: var(--color-highlight, #d3a35a);
    }

    .menu-product-card__title a:hover {
      color: var(--color-highlight, #d3a35a);
    }
  }

  /*
   * CATALOG REVEALS
   * Every group remains visible by default. JavaScript adds the ready class
   * only when the browser can observe and reveal the group safely.
   */
  .catalog-page__hero.is-animation-ready .catalog-page__eyebrow,
  .catalog-page__hero.is-animation-ready .catalog-page__heading,
  .catalog-page__hero.is-animation-ready .catalog-page__hero-support,
  .catalog-page__categories.is-animation-ready,
  .catalog-page__toolbar.is-animation-ready,
  .menu-product-card.is-animation-ready,
  .menu-product-card.is-animation-ready .menu-product-card__image,
  .menu-product-card.is-animation-ready .menu-product-card__content,
  .catalog-page__empty.is-animation-ready svg,
  .catalog-page__empty.is-animation-ready h2,
  .catalog-page__empty.is-animation-ready p,
  .catalog-page__empty.is-animation-ready small,
  .catalog-page__pagination.is-animation-ready {
    transition:
      opacity 430ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 430ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .catalog-page__hero.is-animation-ready .catalog-page__heading {
    transition-delay: 50ms;
  }

  .catalog-page__hero.is-animation-ready .catalog-page__hero-support {
    transition-delay: 100ms;
  }

  .catalog-page__categories.is-animation-ready {
    transition-delay: 80ms;
  }

  .catalog-page__toolbar.is-animation-ready {
    transition-delay: 100ms;
  }

  /*
   * Card content is one reveal unit: titles, variants, prices, availability,
   * and the product link never animate independently from one another.
   */
  .menu-product-card.is-animation-ready {
    transition-delay: var(--catalog-card-delay, 0ms);
  }

  .menu-product-card.is-animation-ready .menu-product-card__image {
    transition-delay: 0ms;
  }

  .menu-product-card.is-animation-ready .menu-product-card__content {
    transition-delay: 35ms;
  }

  .catalog-page__empty.is-animation-ready h2 {
    transition-delay: 60ms;
  }

  .catalog-page__empty.is-animation-ready p {
    transition-delay: 100ms;
  }

  .catalog-page__empty.is-animation-ready small {
    transition-delay: 140ms;
  }

  /* Phone groups use small vertical movement to avoid obscuring products. */
  .catalog-page__hero.is-animation-ready:not(.is-visible) .catalog-page__eyebrow,
  .catalog-page__hero.is-animation-ready:not(.is-visible) .catalog-page__heading,
  .catalog-page__hero.is-animation-ready:not(.is-visible) .catalog-page__hero-support,
  .catalog-page__categories.is-animation-ready:not(.is-visible),
  .catalog-page__toolbar.is-animation-ready:not(.is-visible),
  .menu-product-card.is-animation-ready:not(.is-visible),
  .catalog-page__pagination.is-animation-ready:not(.is-visible) {
    opacity: 0;
    transform: translateY(1rem);
  }

  .menu-product-card.is-animation-ready:not(.is-visible) .menu-product-card__image {
    opacity: 0;
    transform: scale(1.035);
  }

  .menu-product-card.is-animation-ready:not(.is-visible) .menu-product-card__content {
    opacity: 0;
    transform: translateY(0.65rem);
  }

  .catalog-page__empty.is-animation-ready:not(.is-visible) svg {
    opacity: 0;
    transform: scale(0.82);
  }

  .catalog-page__empty.is-animation-ready:not(.is-visible) h2,
  .catalog-page__empty.is-animation-ready:not(.is-visible) p,
  .catalog-page__empty.is-animation-ready:not(.is-visible) small {
    opacity: 0;
    transform: translateY(0.75rem);
  }

  /* Two product cards per row on larger phones and tablets. */
  @media screen and (min-width: 620px) {
    .catalog-page__toolbar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .catalog-page__sort {
      flex-wrap: nowrap;
    }

    .catalog-page__sort label {
      width: auto;
    }

    .catalog-page__pagination-controls {
      max-width: 46rem;
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 0.75rem;
    }

    .catalog-page__pagination-pages {
      display: flex;
      width: auto;
      grid-column: 2;
      grid-row: 1;
      flex-wrap: wrap;
      justify-content: center;
    }

    .catalog-page__pagination-pages a,
    .catalog-page__pagination-pages > span {
      width: auto;
      min-width: 2.75rem;
    }

    .catalog-page__pagination-controls > .catalog-page__pagination-arrow:last-child {
      grid-column: 3;
    }

    .menu-product-card {
      width: calc(50% - 0.5rem);
      flex-basis: calc(50% - 0.5rem);
    }

    /*
     * Tablet delays reset every two cards. They never increase with the total
     * number of products in the collection.
     */
    .menu-product-card:nth-child(2n + 1) {
      --catalog-card-delay: 0ms;
    }

    .menu-product-card:nth-child(2n) {
      --catalog-card-delay: 55ms;
    }
  }

  /*
   * DESKTOP LAYOUT
   * The hero becomes a split row, categories can wrap, and the catalog shows
   * three product cards per row.
   */
  @media screen and (min-width: 990px) {
    .catalog-page__inner {
      gap: 2.5rem;
      padding:
        var(--desktop-section-spacing, 8.75rem)
        var(--desktop-page-margin, 4rem);
    }

    .catalog-page__hero {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 4rem;
      padding-block-end: 2.75rem;
    }

    .catalog-page__hero-copy {
      width: 62%;
      flex: 1 1 62%;
    }

    .catalog-page__hero-support {
      width: 32%;
      flex: 0 0 32%;
      align-items: flex-start;
    }

    .catalog-page__heading {
      max-width: none;
      font-size: clamp(6rem, 8vw, 9rem);
    }

    .catalog-page__toolbar {
      padding: 0.85rem 1rem;
    }

    .menu-product-card {
      width: calc(33.333% - 0.667rem);
      flex-basis: calc(33.333% - 0.667rem);
    }

    /* Desktop delays reset for each three-card row. */
    .menu-product-card:nth-child(3n + 1) {
      --catalog-card-delay: 0ms;
    }

    .menu-product-card:nth-child(3n + 2) {
      --catalog-card-delay: 55ms;
    }

    .menu-product-card:nth-child(3n) {
      --catalog-card-delay: 110ms;
    }

    .menu-product-card__title {
      font-size: 1.65rem;
    }

  }

  /* Respect visitors who request reduced interface motion. */
  @media (prefers-reduced-motion: reduce) {
    .catalog-page__category,
    .catalog-page__category-trigger,
    .catalog-page__category-chevron,
    .menu-product-card__image,
    .menu-product-card.is-animation-ready .menu-product-card__image,
    .catalog-page__hero.is-animation-ready .catalog-page__eyebrow,
    .catalog-page__hero.is-animation-ready .catalog-page__heading,
    .catalog-page__hero.is-animation-ready .catalog-page__hero-support,
    .catalog-page__categories.is-animation-ready,
    .catalog-page__toolbar.is-animation-ready,
    .menu-product-card.is-animation-ready,
    .menu-product-card.is-animation-ready .menu-product-card__content,
    .catalog-page__empty.is-animation-ready svg,
    .catalog-page__empty.is-animation-ready h2,
    .catalog-page__empty.is-animation-ready p,
    .catalog-page__empty.is-animation-ready small,
    .catalog-page__pagination.is-animation-ready {
      transition: none;
    }

    .catalog-page__hero.is-animation-ready:not(.is-visible) .catalog-page__eyebrow,
    .catalog-page__hero.is-animation-ready:not(.is-visible) .catalog-page__heading,
    .catalog-page__hero.is-animation-ready:not(.is-visible) .catalog-page__hero-support,
    .catalog-page__categories.is-animation-ready:not(.is-visible),
    .catalog-page__toolbar.is-animation-ready:not(.is-visible),
    .menu-product-card.is-animation-ready:not(.is-visible),
    .menu-product-card.is-animation-ready:not(.is-visible) .menu-product-card__image,
    .menu-product-card.is-animation-ready:not(.is-visible) .menu-product-card__content,
    .catalog-page__empty.is-animation-ready:not(.is-visible) svg,
    .catalog-page__empty.is-animation-ready:not(.is-visible) h2,
    .catalog-page__empty.is-animation-ready:not(.is-visible) p,
    .catalog-page__empty.is-animation-ready:not(.is-visible) small,
    .catalog-page__pagination.is-animation-ready:not(.is-visible) {
      opacity: 1;
      transform: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const revealSelector = '[data-catalog-reveal]';

    const prepareCategoryDropdowns = (scope = document) => {
      const dropdowns = [];

      if (scope.matches && scope.matches('[data-category-dropdown]')) {
        dropdowns.push(scope);
      }

      if (scope.querySelectorAll) {
        dropdowns.push(...scope.querySelectorAll('[data-category-dropdown]'));
      }

      dropdowns.forEach((dropdown) => {
        if (dropdown.dataset.categoryDropdownReady === 'true') return;

        dropdown.dataset.categoryDropdownReady = 'true';
        const trigger = dropdown.querySelector('summary');

        document.addEventListener('click', (event) => {
          if (dropdown.open && !dropdown.contains(event.target)) {
            dropdown.removeAttribute('open');
          }
        });

        dropdown.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape' || !dropdown.open) return;

          dropdown.removeAttribute('open');
          trigger?.focus();
        });
      });
    };

    /*
     * Each card is observed independently, so phone visitors see products
     * reveal as they scroll instead of waiting for one page-wide sequence.
     */
    const prepareCatalogReveals = (scope = document) => {
      const groups = [];

      if (scope.matches && scope.matches(revealSelector)) {
        groups.push(scope);
      }

      if (scope.querySelectorAll) {
        groups.push(...scope.querySelectorAll(revealSelector));
      }

      groups.forEach((group) => {
        if (group.dataset.catalogAnimationReady === 'true') return;

        group.dataset.catalogAnimationReady = 'true';
        group.classList.add('is-animation-ready');

        const revealGroup = () => {
          group.classList.add('is-visible');
        };

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (prefersReducedMotion || !('IntersectionObserver' in window)) {
          revealGroup();
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return;

            revealGroup();
            observer.disconnect();
          },
          {
            threshold: 0.06,
            rootMargin: '0px 0px -4% 0px',
          }
        );

        requestAnimationFrame(() => observer.observe(group));
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener(
        'DOMContentLoaded',
        () => {
          prepareCatalogReveals();
          prepareCategoryDropdowns();
        },
        { once: true }
      );
    } else {
      prepareCatalogReveals();
      prepareCategoryDropdowns();
    }

    /* Reinitialize when Shopify reloads the catalog in the Theme Editor. */
    document.addEventListener('shopify:section:load', (event) => {
      prepareCatalogReveals(event.target);
      prepareCategoryDropdowns(event.target);
    });
  })();
{% endjavascript %}

{% comment %}
  THEME EDITOR SETTINGS
  This JSON schema creates the collection section's controls in Shopify's Theme
  Editor. It must stay valid JSON, so explanatory comments cannot go inside it.
{% endcomment %}
{% schema %}
{
  "name": "Product catalog",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FULL MENU"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override",
      "info": "Leave blank to use the Shopify collection title."
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "header",
      "content": "Product types"
    },
    {
      "type": "checkbox",
      "id": "show_all_products_link",
      "label": "Show All products link",
      "default": true
    },
    {
      "type": "text",
      "id": "all_products_label",
      "label": "All products label",
      "default": "ALL"
    },
    {
      "type": "header",
      "content": "Product cards"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24,
      "info": "Collections with more products automatically show numbered pagination below the grid."
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show product descriptions",
      "default": true
    },
    {
      "type": "range",
      "id": "description_words",
      "label": "Description word limit",
      "min": 8,
      "max": 24,
      "step": 4,
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show one product badge",
      "default": true,
      "info": "Uses custom.menu_badge first, then supported product tags."
    },
    {
      "type": "checkbox",
      "id": "show_variants",
      "label": "Show variant prices",
      "default": true
    },
    {
      "type": "range",
      "id": "variant_limit",
      "label": "Variant prices shown per product",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Empty state"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Heading",
      "default": "THE MENU IS BREWING"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Message",
      "default": "Products added to this collection will appear here."
    }
  ]
}
{% endschema %}
