{% javascript %}
  (() => {
    const pageSelector = '[data-cart-page]';
    const revealSelector = '[data-cart-reveal]';

    const collectMatches = (scope, selector) => {
      const matches = [];

      if (scope.matches && scope.matches(selector)) {
        matches.push(scope);
      }

      if (scope.querySelectorAll) {
        matches.push(...scope.querySelectorAll(selector));
      }

      return matches;
    };

    /*
     * Quantity changes use Shopify's Ajax Cart API and bundled section
     * rendering. The native form and Update button remain as a no-JavaScript
     * fallback, so cart changes are never dependent on this enhancement.
     */
    const initializeCartForm = (page) => {
      if (page.dataset.cartFormReady === 'true') return;

      page.dataset.cartFormReady = 'true';

      const form = page.querySelector('[data-cart-form]');
      if (!form) return;

      const updateButton = form.querySelector('[data-cart-update]');
      const updateLabel = form.querySelector('[data-cart-update-label]');
      const changeStatus = form.querySelector('[data-cart-change-status]');
      const cartNote = form.querySelector('[name="note"]');
      const supportsAjaxCart = 'fetch' in window && 'DOMParser' in window;
      const quantityTimers = new WeakMap();
      let noteSaveTimer;

      const normalizeQuantity = (input) => {
        const minimum = Number.parseInt(input.min, 10) || 1;
        const maximum = Number.parseInt(input.max, 10);
        let quantity = Number.parseInt(input.value, 10);

        if (!Number.isFinite(quantity)) quantity = minimum;
        quantity = Math.max(minimum, quantity);

        if (Number.isFinite(maximum)) {
          quantity = Math.min(maximum, quantity);
        }

        input.value = quantity;
        return quantity;
      };

      const markCartChangedForFallback = () => {
        form.classList.add('is-dirty');

        if (changeStatus) {
          changeStatus.textContent = page.dataset.cartChangesText;
        }
      };

      if (!supportsAjaxCart) {
        form.querySelectorAll('[data-cart-quantity-change]').forEach((button) => {
          button.addEventListener('click', () => {
            const control = button.closest('.cart-page__quantity-control');
            const input = control ? control.querySelector('[data-cart-quantity]') : null;
            if (!input) return;

            const change = Number.parseInt(button.dataset.cartQuantityChange, 10) || 0;
            input.value = normalizeQuantity(input) + change;
            normalizeQuantity(input);
            markCartChangedForFallback();
          });
        });

        form.querySelectorAll('[data-cart-quantity]').forEach((input) => {
          input.addEventListener('change', () => {
            normalizeQuantity(input);
            markCartChangedForFallback();
          });
        });

        if (cartNote) {
          cartNote.addEventListener('input', markCartChangedForFallback);
        }

        form.addEventListener('submit', (event) => {
          if (!event.submitter || event.submitter.name !== 'update') return;

          if (updateButton) updateButton.disabled = true;
          if (updateLabel) updateLabel.textContent = page.dataset.cartUpdatingText;
          if (changeStatus) changeStatus.textContent = '';
        });

        return;
      }

      page.classList.add('is-ajax-enabled');

      const setStatus = (message, isError = false) => {
        if (!changeStatus) return;

        changeStatus.textContent = message;
        changeStatus.classList.toggle('is-error', isError);
      };

      const setUpdating = (isUpdating) => {
        page.classList.toggle('is-updating', isUpdating);

        if (isUpdating) {
          page.setAttribute('aria-busy', 'true');
        } else {
          page.removeAttribute('aria-busy');
        }

        form.querySelectorAll('[data-cart-quantity-change], [data-cart-quantity]').forEach((control) => {
          control.disabled = isUpdating;
        });
      };

      const publishCartUpdate = (cartData) => {
        document.querySelectorAll('[data-cart-count]').forEach((cartCount) => {
          cartCount.textContent = cartData.item_count;
        });

        document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: cartData } }));
      };

      const replaceCartPage = (sectionHtml, options = {}) => {
        const parsedDocument = new DOMParser().parseFromString(sectionHtml, 'text/html');
        const replacement = parsedDocument.querySelector(pageSelector);

        if (!replacement) {
          throw new Error(page.dataset.cartErrorText);
        }

        if (options.noteValue !== undefined) {
          const replacementNote = replacement.querySelector('[name="note"]');
          if (replacementNote) replacementNote.value = options.noteValue;
        }

        page.replaceWith(replacement);
        initializeCartForm(replacement);

        const replacementStatus = replacement.querySelector('[data-cart-change-status]');
        if (replacementStatus) replacementStatus.textContent = replacement.dataset.cartUpdatedText;

        if (options.lineKey) {
          const replacementLine = Array.from(replacement.querySelectorAll('[data-cart-line-key]')).find(
            (line) => line.dataset.cartLineKey === options.lineKey
          );

          if (replacementLine) {
            const focusTarget = options.quantityChange
              ? replacementLine.querySelector(`[data-cart-quantity-change="${options.quantityChange}"]`)
              : replacementLine.querySelector('[data-cart-quantity]');

            if (focusTarget) focusTarget.focus();
          }
        }

        return replacement;
      };

      const updateCartLine = async (input, quantity, quantityChange) => {
        const line = input.closest('[data-cart-line-key]');
        if (!line || page.classList.contains('is-updating')) return;

        const lineKey = line.dataset.cartLineKey;
        const previousQuantity = Number.parseInt(input.defaultValue, 10) || 1;
        if (!lineKey || quantity === previousQuantity) return;

        const noteValue = cartNote ? cartNote.value : undefined;
        setUpdating(true);
        setStatus(page.dataset.cartUpdatingText);

        try {
          const response = await fetch(page.dataset.cartChangeUrl, {
            method: 'POST',
            headers: {
              Accept: 'application/json',
              'Content-Type': 'application/json',
              'X-Requested-With': 'XMLHttpRequest',
            },
            body: JSON.stringify({
              id: lineKey,
              quantity,
              sections: [page.dataset.cartSectionId],
              sections_url: window.location.pathname,
            }),
            credentials: 'same-origin',
          });
          const responseData = await response.json().catch(() => ({}));

          if (!response.ok) {
            throw new Error(responseData.description || responseData.message || page.dataset.cartErrorText);
          }

          const sectionHtml = responseData.sections
            ? responseData.sections[page.dataset.cartSectionId]
            : null;

          if (!sectionHtml) throw new Error(page.dataset.cartErrorText);

          publishCartUpdate(responseData);
          replaceCartPage(sectionHtml, { lineKey, noteValue, quantityChange });
        } catch (error) {
          input.value = previousQuantity;
          setUpdating(false);
          setStatus(error.message || page.dataset.cartErrorText, true);
        }
      };

      form.querySelectorAll('[data-cart-quantity-change]').forEach((button) => {
        button.addEventListener('click', () => {
          const control = button.closest('.cart-page__quantity-control');
          const input = control ? control.querySelector('[data-cart-quantity]') : null;
          if (!input) return;

          const change = Number.parseInt(button.dataset.cartQuantityChange, 10) || 0;
          input.value = normalizeQuantity(input) + change;
          const quantity = normalizeQuantity(input);
          updateCartLine(input, quantity, String(change));
        });
      });

      form.querySelectorAll('[data-cart-quantity]').forEach((input) => {
        input.addEventListener('input', () => {
          window.clearTimeout(quantityTimers.get(input));
          quantityTimers.set(
            input,
            window.setTimeout(() => {
              updateCartLine(input, normalizeQuantity(input));
            }, 450)
          );
        });

        input.addEventListener('change', () => {
          window.clearTimeout(quantityTimers.get(input));
          updateCartLine(input, normalizeQuantity(input));
        });
      });

      if (cartNote) {
        cartNote.addEventListener('input', () => {
          window.clearTimeout(noteSaveTimer);
          noteSaveTimer = window.setTimeout(async () => {
            setStatus(page.dataset.cartUpdatingText);

            try {
              const response = await fetch(page.dataset.cartUpdateUrl, {
                method: 'POST',
                headers: {
                  Accept: 'application/json',
                  'Content-Type': 'application/json',
                  'X-Requested-With': 'XMLHttpRequest',
                },
                body: JSON.stringify({ note: cartNote.value }),
                credentials: 'same-origin',
              });
              const responseData = await response.json().catch(() => ({}));

              if (!response.ok) {
                throw new Error(responseData.description || responseData.message || page.dataset.cartErrorText);
              }

              publishCartUpdate(responseData);
              setStatus(page.dataset.cartNoteSavedText);
            } catch (error) {
              setStatus(error.message || page.dataset.cartErrorText, true);
            }
          }, 600);
        });
      }

      form.addEventListener('submit', (event) => {
        if (event.submitter && event.submitter.name === 'checkout') return;
        event.preventDefault();
      });
    };

    const prepareCartReveals = (scope = document) => {
      collectMatches(scope, revealSelector).forEach((group) => {
        if (group.dataset.cartAnimationReady === 'true') return;

        group.dataset.cartAnimationReady = 'true';
        group.classList.add('is-animation-ready');

        const revealGroup = () => {
          group.classList.add('is-visible');
        };

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (prefersReducedMotion || !('IntersectionObserver' in window)) {
          revealGroup();
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return;

            revealGroup();
            observer.disconnect();
          },
          {
            threshold: 0.06,
            rootMargin: '0px 0px -4% 0px',
          }
        );

        requestAnimationFrame(() => observer.observe(group));
      });
    };

    const initializeCartPage = (scope = document) => {
      collectMatches(scope, pageSelector).forEach(initializeCartForm);
      prepareCartReveals(scope);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initializeCartPage(), { once: true });
    } else {
      initializeCartPage();
    }

    /* Reinitialize when Shopify reloads the cart section in the Theme Editor. */
    document.addEventListener('shopify:section:load', (event) => {
      initializeCartPage(event.target);
    });
  })();
{% endjavascript %}

