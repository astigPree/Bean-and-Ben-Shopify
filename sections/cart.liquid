{% comment %}
  CART DATA SETUP
  Shopify supplies the global `cart` object on /cart. The form below uses
  Shopify's native update and checkout actions so ordering works without
  JavaScript.
{% endcomment %}
{% liquid
  assign cart_form_id = 'CartForm-' | append: section.id
  assign continue_url = section.settings.continue_link

  if continue_url == blank
    assign continue_url = routes.all_products_collection_url
  endif
%}

<section
  class="cart-page full-width"
  aria-labelledby="CartHeading-{{ section.id }}"
  data-cart-page
  data-cart-section-id="{{ section.id }}"
  data-cart-change-url="{{ routes.cart_change_url }}.js"
  data-cart-update-url="{{ routes.cart_update_url }}.js"
  data-cart-changes-text="{{ 'cart.changes_pending' | t | escape }}"
  data-cart-updating-text="{{ 'cart.updating' | t | escape }}"
  data-cart-updated-text="{{ 'cart.updated' | t | escape }}"
  data-cart-note-saved-text="{{ 'cart.note_saved' | t | escape }}"
  data-cart-error-text="{{ 'cart.update_error' | t | escape }}"
>
  <div class="cart-page__inner">
    <header class="cart-page__hero" data-cart-reveal="intro">
      {% if section.settings.eyebrow != blank %}
        <p class="cart-page__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      <div class="cart-page__hero-row">
        <h1 id="CartHeading-{{ section.id }}" class="cart-page__heading">
          {{ section.settings.heading | escape }}
        </h1>

        <p class="cart-page__count">
          {{ 'cart.item_count' | t: count: cart.item_count }}
        </p>
      </div>
    </header>

    {% if cart.item_count > 0 %}
      {% comment %}
        One form owns quantity updates, the optional order note, and checkout.
        The `updates[]` inputs follow the same order as `cart.items`.
      {% endcomment %}
      <form
        id="{{ cart_form_id }}"
        class="cart-page__form"
        action="{{ routes.cart_url }}"
        method="post"
        data-cart-form
      >
        <div class="cart-page__layout">
          <div class="cart-page__items-column">
            <ul class="cart-page__items" role="list">
              {% for item in cart.items %}
                {% liquid
                  assign item_image_alt = item.image.alt | default: item.product.title
                  assign has_public_properties = false

                  for property in item.properties
                    assign property_first_character = property.first | slice: 0

                    if property.last != blank
                      if property_first_character != '_'
                        assign has_public_properties = true
                      endif
                    endif
                  endfor
                %}

                <li
                  class="cart-page__item"
                  data-cart-reveal="item"
                  data-cart-line-key="{{ item.key | escape }}"
                >
                  <article class="cart-page__item-article">
                    <div class="cart-page__item-main">
                      <a
                        class="cart-page__item-media"
                        href="{{ item.url }}"
                        aria-label="{{ item.product.title | escape }}"
                      >
                        {% if item.image != blank %}
                          {{
                            item.image
                            | image_url: width: 600
                            | image_tag:
                              widths: '160, 240, 360, 480, 600',
                              sizes: '(min-width: 990px) 144px, 104px',
                              class: 'cart-page__item-image',
                              loading: 'lazy',
                              alt: item_image_alt
                          }}
                        {% else %}
                          {{
                            'product-1'
                            | placeholder_svg_tag: 'cart-page__item-image cart-page__item-image--placeholder'
                          }}
                        {% endif %}
                      </a>

                      <div class="cart-page__item-copy">
                        <h2 class="cart-page__item-title">
                          <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
                        </h2>

                        {% unless item.product.has_only_default_variant %}
                          <p class="cart-page__item-variant">
                            <span>{{ 'cart.variant' | t }}</span>
                            {{ item.variant.title | escape }}
                          </p>
                        {% endunless %}

                        {% if item.selling_plan_allocation != blank %}
                          <p class="cart-page__item-variant">
                            {{ item.selling_plan_allocation.selling_plan.name | escape }}
                          </p>
                        {% endif %}

                        {% if has_public_properties %}
                          <dl class="cart-page__properties">
                            {% for property in item.properties %}
                              {% assign property_first_character = property.first | slice: 0 %}

                              {% if property.last != blank %}
                                {% if property_first_character != '_' %}
                                  <div>
                                    <dt>{{ property.first | escape }}</dt>
                                    <dd>
                                      {% if property.last contains '/uploads/' %}
                                        <a href="{{ property.last }}">
                                          {{ property.last | split: '/' | last | escape }}
                                        </a>
                                      {% else %}
                                        {{ property.last | escape }}
                                      {% endif %}
                                    </dd>
                                  </div>
                                {% endif %}
                              {% endif %}
                            {% endfor %}
                          </dl>
                        {% endif %}

                        <div class="cart-page__unit-price">
                          <span>{{ 'cart.unit_price' | t }}</span>
                          {% if item.original_price != item.final_price %}
                            <s>{{ item.original_price | money }}</s>
                          {% endif %}
                          <strong>{{ item.final_price | money }}</strong>
                        </div>

                        {% if item.line_level_discount_allocations.size > 0 %}
                          <ul class="cart-page__line-discounts" role="list">
                            {% for allocation in item.line_level_discount_allocations %}
                              <li>
                                {{ allocation.discount_application.title | escape }}
                                (-{{ allocation.amount | money }})
                              </li>
                            {% endfor %}
                          </ul>
                        {% endif %}

                        <a
                          class="cart-page__remove"
                          href="{{ item.url_to_remove }}"
                          aria-label="{{ 'cart.remove_item' | t: title: item.product.title | escape }}"
                        >
                          {{ 'cart.remove' | t }}
                        </a>
                      </div>
                    </div>

                    <div class="cart-page__item-controls">
                      <div class="cart-page__quantity">
                        <label for="CartQuantity-{{ section.id }}-{{ forloop.index }}">
                          {{ 'cart.quantity' | t }}
                        </label>

                        <div class="cart-page__quantity-control">
                          <button
                            type="button"
                            data-cart-quantity-change="-1"
                            aria-label="{{ 'cart.decrease_quantity' | t: title: item.product.title | escape }}"
                          >
                            <span aria-hidden="true">&minus;</span>
                          </button>
                          <input
                            id="CartQuantity-{{ section.id }}-{{ forloop.index }}"
                            type="number"
                            name="updates[]"
                            value="{{ item.quantity }}"
                            min="1"
                            inputmode="numeric"
                            aria-label="{{ 'cart.quantity_for' | t: title: item.product.title | escape }}"
                            data-cart-quantity
                          >
                          <button
                            type="button"
                            data-cart-quantity-change="1"
                            aria-label="{{ 'cart.increase_quantity' | t: title: item.product.title | escape }}"
                          >
                            <span aria-hidden="true">+</span>
                          </button>
                        </div>
                      </div>

                      <p class="cart-page__line-total">
                        <span>{{ 'cart.line_total' | t }}</span>
                        {% if item.original_line_price != item.final_line_price %}
                          <s>{{ item.original_line_price | money }}</s>
                        {% endif %}
                        <strong>{{ item.final_line_price | money }}</strong>
                      </p>
                    </div>
                  </article>
                </li>
              {% endfor %}
            </ul>

            <div class="cart-page__item-tools">
              <a class="cart-page__continue" href="{{ continue_url }}">
                <span aria-hidden="true">←</span>
                {{ section.settings.continue_label | escape }}
              </a>

              <button class="cart-page__update" type="submit" name="update" data-cart-update>
                <span data-cart-update-label>{{ 'cart.update' | t }}</span>
              </button>

              <p
                class="cart-page__change-status cart-page__visually-hidden"
                role="status"
                aria-live="polite"
                data-cart-change-status
              ></p>
            </div>
          </div>

          <aside
            class="cart-page__summary"
            aria-labelledby="CartSummaryHeading-{{ section.id }}"
            data-cart-reveal="summary"
          >
            <h2 id="CartSummaryHeading-{{ section.id }}">
              {{ section.settings.summary_heading | escape }}
            </h2>

            {% if cart.cart_level_discount_applications.size > 0 %}
              <div class="cart-page__summary-discounts">
                {% for discount in cart.cart_level_discount_applications %}
                  <div class="cart-page__summary-row">
                    <span>{{ discount.title | escape }}</span>
                    <strong>-{{ discount.total_allocated_amount | money }}</strong>
                  </div>
                {% endfor %}
              </div>
            {% endif %}

            <div class="cart-page__summary-row cart-page__summary-row--total">
              <span>{{ 'cart.subtotal' | t }}</span>
              <strong>{{ cart.total_price | money }}</strong>
            </div>

            {% if section.settings.fulfillment_message != blank %}
              <p class="cart-page__fulfillment">
                {{ section.settings.fulfillment_message | escape | newline_to_br }}
              </p>
            {% endif %}

            {% if section.settings.show_cart_note %}
              <div class="cart-page__note">
                <label for="CartNote-{{ section.id }}">
                  {{ section.settings.cart_note_label | escape }}
                </label>
                <textarea
                  id="CartNote-{{ section.id }}"
                  name="note"
                  rows="4"
                >{{ cart.note | escape }}</textarea>

                {% if section.settings.cart_note_help != blank %}
                  <p>{{ section.settings.cart_note_help | escape }}</p>
                {% endif %}
              </div>
            {% endif %}

            {% if section.settings.checkout_note != blank %}
              <p class="cart-page__checkout-note">{{ section.settings.checkout_note | escape }}</p>
            {% endif %}

            <button class="cart-page__checkout" type="submit" name="checkout">
              {{ 'cart.checkout' | t }}
            </button>
          </aside>
        </div>
      </form>
    {% else %}
      {% comment %}
        The empty state keeps the page intentional without inventing products,
        offers, fulfillment details, or promotional urgency.
      {% endcomment %}
      <div class="cart-page__empty" data-cart-reveal="empty">
        <svg viewBox="0 0 96 96" fill="none" aria-hidden="true">
          <path d="M23 31h50l-5 49H28l-5-49Z"></path>
          <path d="M34 31V20c0-8 6-14 14-14s14 6 14 14v11"></path>
          <path d="M37 52h22M40 64h16"></path>
        </svg>

        <h2>{{ section.settings.empty_heading | escape }}</h2>
        <p>{{ section.settings.empty_text | escape }}</p>

        <a class="cart-page__empty-action" href="{{ continue_url }}">
          {{ section.settings.empty_button_label | escape }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  /* Mobile-first branded cart foundation. */
  .cart-page {
    width: 100%;
    color: var(--color-foreground, #f3f0e8);
    background:
      radial-gradient(circle at 88% 6%, rgb(211 163 90 / 7%), transparent 24rem),
      var(--color-background, #050505);
  }

  .cart-page__inner {
    display: flex;
    width: min(100%, var(--page-width, 90rem));
    min-height: 70vh;
    flex-direction: column;
    gap: clamp(2rem, 8vw, 3.5rem);
    margin-inline: auto;
    padding:
      var(--mobile-section-spacing, 4.5rem)
      var(--page-margin, 1.25rem);
  }

  .cart-page__hero {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding-block-end: 1.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-border, #c7cbd0) 38%, transparent);
  }

  .cart-page__eyebrow,
  .cart-page__count,
  .cart-page__item-variant span,
  .cart-page__unit-price > span,
  .cart-page__quantity > label,
  .cart-page__line-total > span,
  .cart-page__note label {
    color: var(--color-highlight, #d3a35a);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .cart-page__eyebrow,
  .cart-page__count {
    margin: 0;
  }

  .cart-page__hero-row {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cart-page__heading {
    margin: 0;
    font-family: var(--font-display--family, Impact, sans-serif);
    font-size: clamp(4rem, 18vw, 6.5rem);
    font-style: var(--font-display--style, normal);
    font-weight: var(--font-display--weight, 400);
    letter-spacing: 0.01em;
    line-height: 0.88;
    text-transform: uppercase;
  }

  .cart-page__count {
    color: color-mix(in srgb, var(--color-foreground, #f3f0e8) 62%, transparent);
  }

  .cart-page__form,
  .cart-page__layout,
  .cart-page__items-column,
  .cart-page__items,
  .cart-page__item-article,
  .cart-page__item-main,
  .cart-page__item-copy,
  .cart-page__item-controls,
  .cart-page__quantity,
  .cart-page__line-total,
  .cart-page__summary,
  .cart-page__empty {
    display: flex;
  }

  .cart-page__form,
  .cart-page__layout,
  .cart-page__items-column,
  .cart-page__items,
  .cart-page__item-article,
  .cart-page__item-copy,
  .cart-page__quantity,
  .cart-page__line-total,
  .cart-page__summary,
  .cart-page__empty {
    flex-direction: column;
  }

  .cart-page__layout {
    gap: 1.5rem;
  }

  .cart-page__items {
    margin: 0;
    padding: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-border, #c7cbd0) 30%, transparent);
    list-style: none;
  }

  .cart-page__item {
    padding-block: 1.25rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-border, #c7cbd0) 30%, transparent);
  }

  .cart-page__item-article {
    gap: 1.25rem;
  }

  .cart-page__item-main {
    min-width: 0;
    align-items: flex-start;
    gap: 1rem;
  }

  .cart-page__item-media {
    display: flex;
    width: 6.5rem;
    min-width: 0;
    flex: 0 0 6.5rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-border, #c7cbd0) 30%, transparent);
    border-radius: var(--style-border-radius-cards, 4px);
    background: var(--color-secondary, #151515);
    aspect-ratio: 1;
  }

  .cart-page__item-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-page__item-image--placeholder {
    padding: 17%;
    color: color-mix(in srgb, var(--color-highlight, #d3a35a) 42%, transparent);
    fill: currentColor;
  }

  .cart-page__item-copy {
    min-width: 0;
    flex: 1 1 auto;
    align-items: flex-start;
  }

  .cart-page__item-title {
    margin: 0;
    font-family: var(--font-display--family, Impact, sans-serif);
    font-size: clamp(1.75rem, 8vw, 2.4rem);
    font-style: var(--font-display--style, normal);
    font-weight: var(--font-display--weight, 400);
    letter-spacing: 0.035em;
    line-height: 0.98;
    text-transform: uppercase;
  }

  .cart-page__item-title a {
    color: inherit;
    text-decoration: none;
  }

  .cart-page__item-variant {
    margin: 0.65rem 0 0;
    color: color-mix(in srgb, var(--color-foreground, #f3f0e8) 72%, transparent);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .cart-page__item-variant span {
    margin-inline-end: 0.35rem;
    font-size: 0.62rem;
  }

  .cart-page__properties {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 0.35rem;
    margin: 0.7rem 0 0;
  }

  .cart-page__properties div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .cart-page__properties dt {
    color: color-mix(in srgb, var(--color-foreground, #f3f0e8) 55%, transparent);
  }

  .cart-page__properties dt::after {
    content: ':';
  }

  .cart-page__properties dd {
    margin: 0;
  }

  .cart-page__properties a {
    color: inherit;
  }

  .cart-page__unit-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.55rem;
    margin-block-start: 0.8rem;
    font-size: 0.82rem;
  }

  .cart-page__unit-price > span {
    width: 100%;
    color: color-mix(in srgb, var(--color-foreground, #f3f0e8) 52%, transparent);
    font-size: 0.6rem;
  }

  .cart-page__unit-price s,
  .cart-page__line-total s {
    color: color-mix(in srgb, var(--color-foreground, #f3f0e8) 45%, transparent);
  }

  .cart-page__unit-price strong {
    color: var(--color-highlight, #d3a35a);
  }

  .cart-page__line-discounts {
    margin: 0.65rem 0 0;
    padding: 0;
    color: var(--color-highlight, #d3a35a);
    font-size: 0.72rem;
    line-height: 1.45;
    list-style: none;
  }

  .cart-page__remove {
    margin-block-start: 0.85rem;
    color: color-mix(in srgb, var(--color-foreground, #f3f0e8) 62%, transparent);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-decoration-color: color-mix(in srgb, var(--color-border, #c7cbd0) 55%, transparent);
    text-underline-offset: 0.3em;
    text-transform: uppercase;
  }

  .cart-page__item-controls {
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .cart-page__quantity {
    gap: 0.5rem;
  }

  .cart-page__quantity > label,
  .cart-page__line-total > span {
    color: color-mix(in srgb, var(--color-foreground, #f3f0e8) 55%, transparent);
    font-size: 0.6rem;
  }

  .cart-page__quantity-control {
    display: flex;
    min-height: 2.9rem;
  }

  .cart-page__quantity-control button,
  .cart-page__quantity-control input {
    min-height: 2.9rem;
    border: 1px solid color-mix(in srgb, var(--color-border, #c7cbd0) 42%, transparent);
    border-radius: 0;
    outline: 0;
    color: var(--color-foreground, #f3f0e8);
    background: var(--color-background, #050505);
    font: inherit;
  }

  .cart-page__quantity-control button {
    display: inline-flex;
    width: 2.9rem;
    flex: 0 0 2.9rem;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
    font-size: 1.05rem;
  }

  .cart-page__quantity-control input {
    width: 3.25rem;
    padding: 0.4rem;
    border-inline: 0;
    text-align: center;
    -moz-appearance: textfield;
  }

  .cart-page__quantity-control input::-webkit-inner-spin-button,
  .cart-page__quantity-control input::-webkit-outer-spin-button {
    margin: 0;
    appearance: none;
  }

  .cart-page__line-total {
    align-items: flex-end;
    gap: 0.25rem;
    margin: 0;
    text-align: end;
  }

  .cart-page__line-total strong {
    color: var(--color-highlight, #d3a35a);
    font-size: 1.1rem;
  }

  .cart-page__item-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: 1.25rem;
  }

  .cart-page__continue,
  .cart-page__update,
  .cart-page__checkout,
  .cart-page__empty-action {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--color-action, #f3f0e8);
    border-radius: var(--style-border-radius-buttons, 4px);
    font: inherit;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      color 160ms ease,
      background-color 160ms ease,
      border-color 160ms ease;
  }

  .cart-page__continue {
    min-height: 2.75rem;
    padding-inline: 0;
    border-color: transparent;
    color: var(--color-foreground, #f3f0e8);
  }

  .cart-page__update {
    color: var(--color-action, #f3f0e8);
    background: transparent;
    cursor: pointer;
  }

  .cart-page__form.is-dirty .cart-page__update {
    border-color: var(--color-highlight, #d3a35a);
    color: var(--color-highlight, #d3a35a);
  }

  .cart-page.is-ajax-enabled .cart-page__update {
    display: none;
  }

  .cart-page.is-updating .cart-page__quantity-control,
  .cart-page.is-updating .cart-page__remove {
    pointer-events: none;
    opacity: 0.5;
  }

  .cart-page__change-status.is-error {
    position: static;
    width: 100%;
    height: auto;
    overflow: visible;
    clip: auto;
    clip-path: none;
    color: #ef9a9a;
    font-size: 0.76rem;
    line-height: 1.45;
    white-space: normal;
  }

  .cart-page__summary {
    gap: 1.25rem;
    padding: clamp(1.25rem, 5vw, 2rem);
    border: 1px solid color-mix(in srgb, var(--color-border, #c7cbd0) 36%, transparent);
    background: var(--color-secondary, #151515);
  }

  .cart-page__summary h2,
  .cart-page__empty h2 {
    margin: 0;
    font-family: var(--font-display--family, Impact, sans-serif);
    font-size: clamp(2rem, 9vw, 3rem);
    font-style: var(--font-display--style, normal);
    font-weight: var(--font-display--weight, 400);
    letter-spacing: 0.06em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .cart-page__summary-discounts {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-block-end: 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-border, #c7cbd0) 25%, transparent);
  }

  .cart-page__summary-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    color: color-mix(in srgb, var(--color-foreground, #f3f0e8) 72%, transparent);
    font-size: 0.78rem;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .cart-page__summary-row strong {
    color: var(--color-highlight, #d3a35a);
    text-align: end;
  }

  .cart-page__summary-row--total {
    padding-block: 1rem;
    border-block:
      1px solid color-mix(in srgb, var(--color-border, #c7cbd0) 28%, transparent);
    color: var(--color-foreground, #f3f0e8);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .cart-page__summary-row--total strong {
    font-size: 1.45rem;
  }

  .cart-page__fulfillment,
  .cart-page__checkout-note,
  .cart-page__note p {
    margin: 0;
