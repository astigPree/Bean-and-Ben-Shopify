  /*
   * CART REVEALS
   * Content is visible by default. JavaScript adds the ready class only when
   * the browser can safely observe each group.
   */
  .cart-page__hero.is-animation-ready .cart-page__eyebrow,
  .cart-page__hero.is-animation-ready .cart-page__heading,
  .cart-page__hero.is-animation-ready .cart-page__count,
  .cart-page__item.is-animation-ready,
  .cart-page__item.is-animation-ready .cart-page__item-image,
  .cart-page__summary.is-animation-ready,
  .cart-page__empty.is-animation-ready svg,
