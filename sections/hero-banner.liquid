<section class="hero-banner">

  {% if section.settings.background_image %}

    <img
      src="{{ section.settings.background_image | image_url: width: 2000 }}"
      alt="{{ section.settings.heading }}"
      class="hero-banner__image" 
      width="100%"
      height="20px"
    >

  {% endif %}

  <div class="page-width">

    <h1
      style="color : {{ settings.primary_color }};"
    >{{ section.settings.heading }}</h1>

    <p>{{ section.settings.description }}</p>

    <a href="{{ section.settings.button_link }}" class="button">
      {{ section.settings.button_text }}
    </a>

  </div>

</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
        "type" : "text",
        "id" : "heading",
        "label": "Heading",
        "default": "Welcome to K.E. Designer"
    },
    {
        "type" : "text",
        "id" : "subheading",
        "label" : "Subheading",
        "default" : "We build modern Shopify experiences."
    },
    {
        "type" : "url",
        "id" : "button_link",
        "label" : "Shop Now Link",
        "default" : "/collections/all"
    },
    {
        "type" : "text",
        "id" : "button_text",
        "label": "Shop Now Text",
        "default": "Shop Now"
    },
    {
      "type": "text",
      "id" : "description",
      "label": "Description",
      "default": "We build modern Shopify experiences."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}