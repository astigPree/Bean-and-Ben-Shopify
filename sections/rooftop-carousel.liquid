  The schema defines content, autoplay, responsive slide widths, colors, and up
  to twelve repeatable image blocks. It must remain strict comment-free JSON.
{% endcomment %}
{% schema %}
{
  "name": "Rooftop carousel",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Rooftop atmosphere"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
