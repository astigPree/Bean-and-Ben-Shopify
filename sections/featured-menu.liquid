{% comment %}
  FEATURED MENU DATA SETUP
  Products can come from a manually ordered product list or a fallback Shopify
  collection. All product names, images, descriptions, prices, and availability
  remain connected to Shopify product data.
{% endcomment %}
{% liquid
  assign featured_products = section.settings.products

  # The manually selected list has priority over the fallback collection.
  if featured_products == blank
    if section.settings.collection != blank
      assign featured_products = section.settings.collection.products
    endif
  endif

  assign featured_product_count = featured_products | size
  assign menu_link = section.settings.menu_link
  assign background_overlay_opacity = section.settings.background_overlay_opacity | divided_by: 100.0

  # Link priority: custom menu URL, selected collection, then All products.
  if menu_link == blank
    if section.settings.collection != blank
      assign menu_link = section.settings.collection.url
    else
      assign menu_link = routes.all_products_collection_url
    endif
  endif
%}

{% comment %}
  Theme Editor color, image-position, and overlay values are passed to CSS
  custom properties so they affect only this section instance.
{% endcomment %}
<section
  class="featured-menu full-width"
  style="
    --featured-menu-background: {{ section.settings.background_color }};
    --featured-menu-surface: {{ section.settings.surface_color }};
    --featured-menu-text: {{ section.settings.text_color }};
    --featured-menu-accent: {{ section.settings.accent_color }};
    --featured-menu-background-position: {{ section.settings.background_image_position }};
    --featured-menu-background-overlay: {{ background_overlay_opacity }};
  "
  data-featured-menu
>
  {% if section.settings.background_image != blank %}
    {% comment %}
      This image is decorative and sits behind the section content.
      Its position and dark overlay can be adjusted in the Theme Editor.
    {% endcomment %}
    <div class="featured-menu__background" aria-hidden="true">
      {{
        section.settings.background_image
        | image_url: width: 3200
        | image_tag:
          widths: '750, 1100, 1500, 2000, 2600, 3200',
          sizes: '100vw',
          class: 'featured-menu__background-image',
          loading: 'lazy',
          alt: ''
      }}
    </div>
    <span class="featured-menu__background-overlay" aria-hidden="true"></span>
  {% endif %}

  <div class="featured-menu__inner">
    <header class="featured-menu__header">
      {% if section.settings.eyebrow != blank %}
        <p class="featured-menu__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="featured-menu__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="featured-menu__description">{{ section.settings.description | escape }}</p>
      {% endif %}
    </header>

    {% comment %}
      Products are sourced only from Shopify. The manually selected product
      list is preferred; the selected collection is used when that list is empty.
      The first product uses the large lead-card style; products two through five
      use the supporting-card style from the same reusable snippet.
    {% endcomment %}
    {% if featured_product_count > 0 %}
      <div class="featured-menu__products">
        {% for product in featured_products limit: 1 %}
          {% render 'featured-menu-card',
            product: product,
            card_style: 'lead',
            lead_badge: section.settings.lead_badge,
            reveal_delay: 180
          %}
        {% endfor %}

        {% if featured_product_count > 1 %}
          <div class="featured-menu__supporting">
            {% for product in featured_products offset: 1 limit: 4 %}
              {% assign supporting_reveal_delay = forloop.index0 | times: 55 | plus: 230 %}
              {% render 'featured-menu-card',
                product: product,
                card_style: 'supporting',
                reveal_delay: supporting_reveal_delay
              %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% else %}
      {% comment %}
        This branded empty state prevents a broken or blank section before
        products are selected, without inventing fake products or prices.
      {% endcomment %}
      <div class="featured-menu__empty">
        <svg class="featured-menu__empty-icon" viewBox="0 0 96 96" fill="none" aria-hidden="true">
          <path d="M24 35h43l-4 43H28l-4-43Z"></path>
          <path d="M21 27h49M30 19h31M67 43h6a10 10 0 0 1 0 20h-8"></path>
          <path d="M37 53c4-5 18-5 22 0M40 62h16"></path>
        </svg>

        <div class="featured-menu__empty-content">
          <p class="featured-menu__empty-heading">{{ section.settings.empty_heading | escape }}</p>
          <p class="featured-menu__empty-text">{{ section.settings.empty_text | escape }}</p>

          {% if request.design_mode %}
            <p class="featured-menu__editor-note">
              Select featured products or a fallback collection in this section's settings.
            </p>
          {% endif %}
        </div>
      </div>
    {% endif %}

    {% comment %}
      The footer destination was resolved during data setup, so this link remains
      useful even when the merchant leaves the custom Menu link setting empty.
    {% endcomment %}
    {% if section.settings.menu_label != blank %}
      <div class="featured-menu__footer">
        <span class="featured-menu__footer-rule" aria-hidden="true"></span>
        <a class="featured-menu__menu-link" href="{{ menu_link }}">
          <span>{{ section.settings.menu_label | escape }}</span>
          <svg viewBox="0 0 32 20" fill="none" aria-hidden="true">
            <path d="M1 10h28M21 2l8 8-8 8"></path>
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  /* Mobile-first section foundation and typography. */
  .featured-menu {
    position: relative;
    overflow: hidden;
    color: var(--featured-menu-text, #f3f0e8);
    background:
      radial-gradient(circle at 72% 28%, rgb(255 255 255 / 4%), transparent 30rem),
      radial-gradient(circle at 15% 85%, rgb(242 140 24 / 5%), transparent 24rem),
      var(--featured-menu-background, #050505);
    isolation: isolate;
  }

  /* The optional uploaded background and its readability overlay stay behind all content. */
  .featured-menu__background,
  .featured-menu__background-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .featured-menu__background {
    z-index: -2;
    display: flex;
  }

  .featured-menu__background-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--featured-menu-background-position, center center);
  }

  .featured-menu__background-overlay {
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(0 0 0 / 30%), transparent 24%, rgb(0 0 0 / 45%) 100%),
      var(--featured-menu-background, #050505);
    opacity: var(--featured-menu-background-overlay, 0.65);
  }

  /* Constrains and centers the section content using mobile-first global spacing. */
  .featured-menu__inner {
    position: relative;
    z-index: 1;
    display: flex;
    width: min(100%, 106rem);
    flex-direction: column;
    gap: 2.5rem;
    margin-inline: auto;
    padding:
      var(--mobile-section-spacing, 4.5rem)
      var(--page-margin, 1.25rem);
  }

  .featured-menu__header {
    position: relative;
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: flex-start;
  }

  .featured-menu__eyebrow {
    margin: 0 0 1.25rem;
    color: var(--featured-menu-accent, #d3a35a);
    font-size: clamp(0.8rem, 3.6vw, 1rem);
    font-weight: 650;
    letter-spacing: 0.3em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .featured-menu__heading {
    max-width: 15ch;
    margin: 0;
    font-family: var(--font-display--family, Impact, sans-serif);
    font-size: clamp(3.25rem, 14vw, 5.5rem);
    font-style: var(--font-display--style, normal);
    font-weight: var(--font-display--weight, 400);
    letter-spacing: 0.01em;
    line-height: 0.88;
    text-transform: uppercase;
  }

  .featured-menu__description {
    max-width: 42rem;
    margin: 1.35rem 0 0;
    font-size: clamp(0.95rem, 4vw, 1.2rem);
    line-height: 1.5;
  }

  .featured-menu__header::after {
    display: block;
    width: 100%;
    height: 1px;
    margin-block-start: 1.5rem;
    content: '';
    background: color-mix(in srgb, var(--featured-menu-accent, #f28c18) 45%, transparent);
  }

  /*
   * The lead product is full width on phones. Supporting products are paired
   * in two columns, exactly like the supplied mobile reference.
   */
  .featured-menu__products {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .featured-menu__supporting {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /*
   * Card markup is rendered by snippets/featured-menu-card.liquid. The snippet
   * supplies Shopify product data; these classes control its two visual styles.
   */
  .featured-menu__card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--featured-menu-accent, #f28c18) 72%, transparent);
    border-radius: clamp(0.65rem, 2.5vw, 1rem);
    background: var(--featured-menu-surface, #151515);
  }

  .featured-menu__card--lead {
    min-height: clamp(31rem, 122vw, 40rem);
  }

  .featured-menu__card--supporting {
    width: calc(50% - 0.375rem);
    min-height: clamp(17rem, 72vw, 23rem);
    flex: 1 1 calc(50% - 0.375rem);
  }

  .featured-menu__card-link {
    position: relative;
    display: flex;
    width: 100%;
    height: 100%;
    min-height: inherit;
    align-items: stretch;
    color: inherit;
    text-decoration: none;
    isolation: isolate;
  }

  /* The lead uses one cinematic image behind its copy. */
  .featured-menu__card--lead .featured-menu__media,
  .featured-menu__card--lead .featured-menu__card-overlay {
    position: absolute;
    inset: 0;
  }

  .featured-menu__media {
    display: flex;
    min-width: 0;
    background: var(--featured-menu-surface, #151515);
  }

  .featured-menu__card--lead .featured-menu__media {
    z-index: -3;
  }

  .featured-menu__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% center;
    transition: transform 400ms ease;
  }

  .featured-menu__image--placeholder {
    padding: 18%;
    color: color-mix(in srgb, var(--featured-menu-accent, #f28c18) 45%, transparent);
    background: var(--featured-menu-surface, #151515);
    fill: currentColor;
  }

  .featured-menu__card--lead .featured-menu__card-overlay {
    z-index: -2;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 95%) 0%, rgb(0 0 0 / 76%) 38%, transparent 78%),
      linear-gradient(180deg, rgb(0 0 0 / 10%), transparent 45%, rgb(0 0 0 / 58%) 100%);
  }

  /*
   * Supporting cards use an image-and-copy split instead of covering the text
   * with an image. This is the key layout visible in both references.
   */
  .featured-menu__card--supporting .featured-menu__card-link {
    flex-direction: row;
  }

  .featured-menu__card--supporting .featured-menu__media {
    width: 50%;
    min-height: 100%;
    flex: 1 1 50%;
  }

  .featured-menu__card--supporting .featured-menu__card-overlay {
    display: none;
  }

  .featured-menu__card-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .featured-menu__card--lead .featured-menu__card-content {
    width: min(58%, 20rem);
    height: 100%;
    min-height: inherit;
    padding: clamp(1.35rem, 6vw, 2.25rem);
  }

  .featured-menu__card--supporting .featured-menu__card-content {
    width: 50%;
    min-height: 100%;
    flex: 1 1 50%;
    padding: clamp(0.6rem, 2.5vw, 0.9rem);
  }

  .featured-menu__card-heading,
  .featured-menu__card-details {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: flex-start;
  }

  .featured-menu__badge {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    justify-content: center;
    margin-block-end: 1rem;
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--featured-menu-accent, #f28c18);
    color: var(--featured-menu-accent, #f28c18);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .featured-menu__product-title,
  .featured-menu__empty-heading {
    margin: 0;
    font-family: var(--font-display--family, Impact, sans-serif);
    font-style: var(--font-display--style, normal);
    font-weight: var(--font-display--weight, 400);
    letter-spacing: 0.015em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .featured-menu__product-title {
    max-width: 15ch;
    font-size: clamp(2.4rem, 11vw, 4.25rem);
  }

  .featured-menu__card--supporting .featured-menu__product-title {
    font-size: clamp(1.2rem, 5vw, 1.75rem);
    line-height: 1;
  }

  .featured-menu__product-rule {
    position: relative;
    display: block;
    width: 100%;
    height: 1px;
    margin-block: 0 1rem;
    background: color-mix(in srgb, var(--featured-menu-accent, #f28c18) 70%, transparent);
  }

  .featured-menu__product-rule::before {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0;
    width: 0.45rem;
    height: 0.45rem;
    content: '';
    background: var(--featured-menu-accent, #f28c18);
    transform: translateY(-50%) rotate(45deg);
  }

  .featured-menu__product-description {
    max-width: 28rem;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .featured-menu__card--supporting .featured-menu__product-description {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.72rem;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .featured-menu__price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 1rem 0 0;
    color: var(--featured-menu-accent, #f28c18);
    font-size: clamp(1.75rem, 8vw, 2.75rem);
    font-weight: 650;
    line-height: 1;
  }

  .featured-menu__card--supporting .featured-menu__price {
    font-size: clamp(1.2rem, 5.5vw, 1.75rem);
  }

  .featured-menu__price span {
    font-size: 0.8rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .featured-menu__card.is-sold-out .featured-menu__image {
    filter: grayscale(0.65);
  }

  /* Branded fallback shown when Shopify has no selected products to render. */
  .featured-menu__empty {
    display: flex;
    min-height: 25rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: clamp(2.5rem, 10vw, 5rem) 1.5rem;
    border: 1px solid var(--featured-menu-accent, #f28c18);
    border-radius: var(--style-border-radius-buttons, 4px);
    text-align: center;
    background:
      linear-gradient(135deg, rgb(255 255 255 / 3%), transparent 50%),
      var(--featured-menu-surface, #151515);
  }

  .featured-menu__empty-icon {
    width: clamp(5rem, 22vw, 8rem);
    color: var(--featured-menu-accent, #f28c18);
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.4;
  }

  .featured-menu__empty-content {
    display: flex;
    max-width: 36rem;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .featured-menu__empty-heading {
    font-size: clamp(2.75rem, 11vw, 4.5rem);
  }

  .featured-menu__empty-text,
  .featured-menu__editor-note {
    margin: 0;
    line-height: 1.6;
  }

  .featured-menu__editor-note {
    color: var(--featured-menu-accent, #f28c18);
    font-size: 0.85rem;
  }

  .featured-menu__footer {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .featured-menu__footer-rule {
    display: none;
    height: 1px;
    flex: 1 1 auto;
    background: color-mix(in srgb, var(--featured-menu-accent, #f28c18) 70%, transparent);
  }

  .featured-menu__menu-link {
    display: inline-flex;
    width: 100%;
    min-height: 4.5rem;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--featured-menu-accent, #f28c18);
    color: var(--featured-menu-accent, #f28c18);
    font-size: clamp(0.8rem, 3.5vw, 1rem);
    font-weight: 650;
    letter-spacing: 0.2em;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  .featured-menu__menu-link svg {
    width: 2rem;
    flex: 0 0 auto;
    stroke: currentColor;
    stroke-linecap: square;
    stroke-linejoin: miter;
    stroke-width: 1.5;
  }

  /*
   * SCROLL REVEAL ENHANCEMENT
   * Everything remains visible by default. JavaScript adds the ready class only
   * when it can observe the section, preserving the complete no-JavaScript view.
   */
  .featured-menu.is-animation-ready .featured-menu__eyebrow,
  .featured-menu.is-animation-ready .featured-menu__heading,
  .featured-menu.is-animation-ready .featured-menu__description {
    transition:
      opacity 420ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .featured-menu.is-animation-ready .featured-menu__heading {
    transition-delay: 60ms;
  }

  .featured-menu.is-animation-ready .featured-menu__description {
    transition-delay: 120ms;
  }

  .featured-menu.is-animation-ready .featured-menu__card {
    transition:
      opacity 500ms cubic-bezier(0.22, 1, 0.36, 1) var(--featured-card-delay, 180ms),
      transform 500ms cubic-bezier(0.22, 1, 0.36, 1) var(--featured-card-delay, 180ms);
  }

  .featured-menu.is-animation-ready .featured-menu__media {
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1) var(--featured-card-delay, 180ms);
  }

  .featured-menu.is-animation-ready .featured-menu__empty {
    transition:
      opacity 500ms cubic-bezier(0.22, 1, 0.36, 1) 180ms,
      transform 500ms cubic-bezier(0.22, 1, 0.36, 1) 180ms;
  }

  .featured-menu.is-animation-ready .featured-menu__footer-rule {
    transform-origin: left center;
    transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1) 450ms;
  }

  .featured-menu.is-animation-ready .featured-menu__menu-link {
    transition:
      color 160ms ease,
      background-color 160ms ease,
      opacity 400ms cubic-bezier(0.22, 1, 0.36, 1) 500ms,
      transform 400ms cubic-bezier(0.22, 1, 0.36, 1) 500ms;
  }

  .featured-menu.is-animation-ready:not(.is-visible) .featured-menu__eyebrow,
  .featured-menu.is-animation-ready:not(.is-visible) .featured-menu__heading,
  .featured-menu.is-animation-ready:not(.is-visible) .featured-menu__description,
  .featured-menu.is-animation-ready:not(.is-visible) .featured-menu__card,
  .featured-menu.is-animation-ready:not(.is-visible) .featured-menu__empty,
  .featured-menu.is-animation-ready:not(.is-visible) .featured-menu__menu-link {
    opacity: 0;
    transform: translateY(1.25rem);
  }

  .featured-menu.is-animation-ready:not(.is-visible) .featured-menu__media {
    transform: scale(1.03);
  }

  .featured-menu.is-animation-ready:not(.is-visible) .featured-menu__footer-rule {
    transform: scaleX(0);
  }

  @media (hover: hover) {
    .featured-menu__card-link:hover .featured-menu__image {
      transform: scale(1.025);
    }

    .featured-menu__menu-link:hover {
      color: var(--featured-menu-background, #050505);
      background: var(--featured-menu-accent, #f28c18);
    }
  }

  /* Larger phones keep two supporting products on each row with taller cards. */
  @media screen and (min-width: 600px) {
    .featured-menu__card--supporting {
      width: calc(50% - 0.5rem);
      min-height: 28rem;
      flex-basis: calc(50% - 0.5rem);
    }

    .featured-menu__card--supporting .featured-menu__media,
    .featured-menu__card--supporting .featured-menu__card-content {
      width: 50%;
      min-height: 100%;
      flex-basis: 50%;
    }
  }

  /*
   * DESKTOP LAYOUT
   * Places the lead card beside a wrapping two-by-two supporting-card group.
   */
  @media screen and (min-width: 990px) {
    .featured-menu__inner {
      gap: 3rem;
      padding:
        var(--desktop-section-spacing, 8.75rem)
        var(--desktop-page-margin, 4rem);
    }

    .featured-menu__eyebrow {
      margin-block-end: 1.5rem;
      font-size: 1rem;
    }

    .featured-menu__heading {
      max-width: none;
      font-size: clamp(5rem, 7.1vw, 8rem);
      white-space: nowrap;
    }

    .featured-menu__description {
      font-size: 1.2rem;
    }

    .featured-menu__header::after {
      position: absolute;
      right: 0;
      bottom: 0.5rem;
      width: calc(100% - 44rem);
      margin: 0;
    }

    .featured-menu__products {
      min-height: 44rem;
      flex-direction: row;
    }

    .featured-menu__card--lead {
      width: calc(50% - 0.5rem);
      min-height: 44rem;
      flex: 1 1 calc(50% - 0.5rem);
    }

    .featured-menu__products > .featured-menu__card--lead:only-child {
      width: 100%;
      flex-basis: 100%;
    }

    .featured-menu__supporting {
      width: calc(50% - 0.5rem);
      flex: 1 1 calc(50% - 0.5rem);
    }

    .featured-menu__card--supporting {
      width: calc(50% - 0.5rem);
      min-height: calc(50% - 0.5rem);
      flex: 1 1 calc(50% - 0.5rem);
    }

    .featured-menu__card--lead .featured-menu__card-content {
      width: min(45%, 25rem);
      padding: 2.75rem;
    }

    .featured-menu__card--supporting .featured-menu__card-content {
      padding: 1.15rem;
    }

    .featured-menu__card--supporting .featured-menu__product-title {
      font-size: clamp(1.5rem, 1.8vw, 2.25rem);
    }

    .featured-menu__card--supporting .featured-menu__product-description {
      font-size: clamp(0.7rem, 0.8vw, 0.9rem);
    }

    .featured-menu__card--supporting .featured-menu__price {
      font-size: clamp(1.4rem, 1.8vw, 2.1rem);
    }

    .featured-menu__empty {
      min-height: 32rem;
      flex-direction: row;
      text-align: start;
    }

    .featured-menu__empty-content {
      align-items: flex-start;
    }

    .featured-menu__footer-rule {
      display: block;
    }

    .featured-menu__menu-link {
      width: min(100%, 28rem);
      min-height: 5rem;
      flex: 0 0 28rem;
    }

    .featured-menu.is-animation-ready:not(.is-visible) .featured-menu__eyebrow,
    .featured-menu.is-animation-ready:not(.is-visible) .featured-menu__heading,
    .featured-menu.is-animation-ready:not(.is-visible) .featured-menu__description,
    .featured-menu.is-animation-ready:not(.is-visible) .featured-menu__card--lead {
      transform: translateX(-1.5rem);
    }

    .featured-menu.is-animation-ready:not(.is-visible) .featured-menu__card--supporting {
      transform: translateX(1.5rem);
    }
  }

  /* Disable decorative transitions when the visitor requests reduced motion. */
  @media (prefers-reduced-motion: reduce) {
    .featured-menu.is-animation-ready .featured-menu__eyebrow,
    .featured-menu.is-animation-ready .featured-menu__heading,
    .featured-menu.is-animation-ready .featured-menu__description,
    .featured-menu.is-animation-ready .featured-menu__card,
    .featured-menu.is-animation-ready .featured-menu__media,
    .featured-menu.is-animation-ready .featured-menu__empty,
    .featured-menu.is-animation-ready .featured-menu__footer-rule,
    .featured-menu.is-animation-ready .featured-menu__menu-link,
    .featured-menu__image,
    .featured-menu__menu-link {
      transition: none;
    }

    .featured-menu.is-animation-ready:not(.is-visible) .featured-menu__eyebrow,
    .featured-menu.is-animation-ready:not(.is-visible) .featured-menu__heading,
    .featured-menu.is-animation-ready:not(.is-visible) .featured-menu__description,
    .featured-menu.is-animation-ready:not(.is-visible) .featured-menu__card,
    .featured-menu.is-animation-ready:not(.is-visible) .featured-menu__media,
    .featured-menu.is-animation-ready:not(.is-visible) .featured-menu__empty,
    .featured-menu.is-animation-ready:not(.is-visible) .featured-menu__footer-rule,
    .featured-menu.is-animation-ready:not(.is-visible) .featured-menu__menu-link {
      opacity: 1;
      transform: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  /*
   * Reveal each featured menu once as it enters the viewport. The ready marker
   * prevents duplicate observers after Shopify Theme Editor section reloads.
   */
  const initializeFeaturedMenuAnimations = (root = document) => {
    root.querySelectorAll('[data-featured-menu]:not([data-animation-ready])').forEach((menu) => {
      menu.setAttribute('data-animation-ready', '');
      menu.classList.add('is-animation-ready');

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const revealMenu = () => {
        menu.classList.add('is-visible');
      };

      if (reducedMotion || !('IntersectionObserver' in window)) {
        revealMenu();
        return;
      }

      const observer = new IntersectionObserver((entries) => {
        if (!entries[0]?.isIntersecting) return;

        revealMenu();
        observer.disconnect();
      }, {
        threshold: 0.08,
        rootMargin: '0px 0px -8% 0px',
      });

      window.requestAnimationFrame(() => {
        observer.observe(menu);
      });
    });
  };

  initializeFeaturedMenuAnimations();

  document.addEventListener('shopify:section:load', (event) => {
    initializeFeaturedMenuAnimations(event.target);
  });
{% endjavascript %}

